include "../pico.atm"

pico.open()
pico.set.scene [ dim=['!', w=100, h=100] ]

print("pico.in.rect smoke")
do {
    val out   = ['!', x=20, y=20, w=60, h=60, anchor='NW']
    val child = ['%', x=0.5, y=0.5, w=0.5, h=0.5, anchor='C']
    val ret = pico.in.rect(out, child)
    assert(ret@0 == '%')
    assert(ret.anchor.x==0.5 && ret.anchor.y==0.5)
    val abs = pico.cv.rect(nil, '!', nil, ret)
    assert(math.floor(abs.x+0.5)==50 && math.floor(abs.y+0.5)==50)
    assert(math.floor(abs.w+0.5)==30 && math.floor(abs.h+0.5)==30)
}

print("pico.in.pos smoke")
do {
    do {
        val out   = ['!', x=20, y=20, w=60, h=60]
        val child = ['%', x=0.5, y=0.5]
        val ret = pico.in.pos(out, child)
        assert(ret@0 == '%')
        val abs = pico.cv.pos(nil, '!', nil, ret)
        assert(abs.x==20.5 && abs.y==20.5)
    }
    do {
        val out   = ['!', x=20, y=20, w=60, h=60]
        val child = ['%', x=0.5, y=0.5]
        val ret = pico.in.pos(out, child)
        assert(ret@0 == '%')
        val abs = pico.cv.pos(['!',anchor='NW'], ret)
        assert(abs.x==20 && abs.y==20)
    }
}

print("pico.in.dim smoke")
do {
    val out   = ['!', x=20, y=20, w=60, h=60, anchor='NW']
    val child = ['%', w=0.5, h=0.5]
    val ret = pico.in.dim(out, child)
    assert(ret@0 == '%')
    val abs = pico.cv.dim(nil, '!', nil, ret)
    assert(math.floor(abs.w+0.5)==30 && math.floor(abs.h+0.5)==30)
}

print("\n=== ALL TESTS PASSED ===")
pico.close()
