;; The reference images come from the C test (`srand(0)`, `rand()%3 - 1`).
;; `math.random(3)` also draws from `rand()`, but scales it instead of taking
;; the remainder, so it walks a different path: the steps use `rand()%3` of C.

pico.set.window [ title="Moving Around" ]
pico.set.layer(pico.layer.window())
pico.set.scene [ dim=['!', w=640, h=360] ]
pico.set.layer(pico.layer.world())
pico.set.scene [ dim=['!', w=64, h=18] ]
math.randomseed(0)

val pos = ['!', x=32, y=9]
loop i in (0,99) {
    pico.set.pencil [ color=[r=0xFF, g=0xFF, b=0xFF] ]
    pico.output.draw.pixel(pos)

    pico.input.delay(10)

    ifs {
        i == 0  => pico.check("move-01")
        i == 20 => pico.check("move-02")
        i == 40 => pico.check("move-03")
        i == 60 => pico.check("move-04")
        i == 80 => pico.check("move-05")
    }

    set pos.x = pos.x + `:number rand()%3` - 1
    set pos.y = pos.y + `:number rand()%3` - 1
}

pico.close()
