include "../pico.atm"

pico.open()
pico.set.window [ title="Blend" ]
pico.set.layer(pico.layer.window())
pico.set.scene [ dim=['!', w=640, h=360] ]
pico.set.layer(pico.layer.world())
pico.set.scene [ dim=['!', w=64, h=36] ]

;; Lua: `for a = 255, 1, -5` (51 iterations: 255, 250, ..., 5)

do {
    print("image dimming")
    val r = ['%', x=0.5, y=0.5, w=0.5, h=0, anchor='C']
    loop i in 51 {
        val a = 255 - i*5
        pico.output.clear()
        pico.set.pencil [ color=pico.color.alpha(pico.get.pencil().color, a) ]
        pico.output.draw.image("../c/res/open.png", r)
        pico.input.delay(10)
        if a == 120 {
            pico.check("blend_pct-01")
        }
    }
}

do {
    print("pixel dimming")
    val p = ['%', x=0.5, y=0.5, anchor='NW']
    loop i in 51 {
        val a = 255 - i*5
        pico.output.clear()
        pico.set.pencil [ color=pico.color.alpha('red', a) ]
        pico.output.draw.pixel(p)
        pico.input.delay(10)
        if a == 120 {
            pico.check("blend_pct-02")
        }
    }
}

do {
    print("text dimming")
    val r = ['%', x=0.5, y=0.5, w=0, h=0.28, anchor='C']
    val z = ['!', x=6.296000, y=12.960000, w=51.408001, h=10.080000, anchor='NW']
    loop i in 51 {
        val a = 255 - i*5
        pico.output.clear()
        pico.set.pencil [ color=pico.color.alpha('red', a) ]
        pico.output.draw.rect(z)
        pico.output.draw.text("SOME TEXT", r)
        pico.input.delay(10)
        if a == 120 {
            pico.check("blend_pct-03")
        }
    }
}

do {
    print("rect dimming")
    val r = ['%', x=0.5, y=0.5, w=0.95, h=0.34, anchor='C']
    loop i in 51 {
        val a = 255 - i*5
        pico.output.clear()
        pico.set.pencil [ color=pico.color.alpha('red', a) ]
        pico.output.draw.rect(r)
        pico.input.delay(10)
        if a == 120 {
            pico.check("blend_pct-04")
        }
    }
}

do {
    print("oval dimming")
    val r = ['%', x=0.5, y=0.5, w=0.95, h=0.34, anchor='C']
    loop i in 51 {
        val a = 255 - i*5
        pico.output.clear()
        pico.set.pencil [ color=pico.color.alpha('red', a) ]
        pico.output.draw.oval(r)
        pico.input.delay(10)
        if a == 120 {
            pico.check("blend_pct-05")
        }
    }
}

do {
    print("tri dimming")
    val p1 = ['%', x=0.50, y=0.33, anchor='C']
    val p2 = ['%', x=0.33, y=0.66, anchor='C']
    val p3 = ['%', x=0.66, y=0.66, anchor='C']
    loop i in 51 {
        val a = 255 - i*5
        pico.output.clear()
        pico.set.pencil [ color=pico.color.alpha('red', a) ]
        pico.output.draw.tri(p1, p2, p3)
        pico.input.delay(10)
        if a == 120 {
            pico.check("blend_pct-06")
        }
    }
}

do {
    print("line dimming")
    val p1 = ['%', x=0.33, y=0.33, anchor='C']
    val p2 = ['%', x=0.66, y=0.66, anchor='C']
    loop i in 51 {
        val a = 255 - i*5
        pico.output.clear()
        pico.set.pencil [ color=pico.color.alpha('red', a) ]
        pico.output.draw.line(p1, p2)
        pico.input.delay(10)
        if a == 120 {
            pico.check("blend_pct-07")
        }
    }
}

do {
    print("poly dimming")
    val poly = [
        ['%', x=0.50, y=0.33, anchor='C'],
        ['%', x=0.33, y=0.66, anchor='C'],
        ['%', x=0.66, y=0.66, anchor='C'],
    ]
    loop i in 51 {
        val a = 255 - i*5
        pico.output.clear()
        pico.set.pencil [ color=pico.color.alpha('red', a) ]
        pico.output.draw.poly(poly)
        pico.input.delay(10)
        if a == 120 {
            pico.check("blend_pct-08")
        }
    }
}

pico.close()
