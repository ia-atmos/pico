include "../pico.atm"

;;os.execute("mkdir -p /tmp/cross")

pico.open()
pico.set.window [ title = "Hello World!" ]

loop i in (0, 99) {
    ;;pico.output.screenshot(pico.layer.window(), string.format("/tmp/cross/%02d.png", i))

    pico.output.draw.pixel ['!', x=i,    y=i]
    pico.output.draw.pixel ['!', x=99-i, y=i]
    pico.input.delay(5)
    ifs {
        i == 0  => pico.check("cross-01")
        i == 49 => pico.check("cross-02")
        i == 99 => pico.check("cross-03")
    }
}

;;os.execute("convert -delay 5 -loop 0 /tmp/cross/*.png ../../res/cross.gif")
;;os.execute("rm -rf /tmp/cross")

pico.close()
