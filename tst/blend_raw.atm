include "../pico.atm"

pico.open()
pico.set.window [ title="Blend" ]
pico.set.layer(pico.layer.window())
pico.set.scene [ dim=['!', w=640, h=360] ]
pico.set.layer(pico.layer.world())
pico.set.scene [ dim=['!', w=64, h=36] ]

;; Lua: `for a = 255, 1, -5` (51 iterations: 255, 250, ..., 5)

do {
    print("pixel dimming")
    val p = ['!', x=32, y=18, anchor='NW']
    loop i in 51 {
        val a = 255 - i*5
        pico.output.clear()
        pico.set.pencil [ color=pico.color.alpha('red', a) ]
        pico.output.draw.pixel(p)
        pico.input.delay(10)
        if a == 120 {
            pico.check("blend_raw-01")
        }
    }
}

do {
    print("text dimming")
    val d = ['!', w=0, h=10]
    pico.get.text(d, "SOME TEXT")
    val r = ['!', x=32-d.w//2, y=18-5, w=nil, h=10, anchor='NW']
    loop i in 51 {
        val a = 255 - i*5
        pico.output.clear()
        pico.set.pencil [ color=pico.color.alpha('red', a) ]
        pico.output.draw.text("SOME TEXT", r)
        pico.input.delay(10)
        if a == 120 {
            pico.check("blend_raw-02")
        }
    }
}

do {
    print("rect dimming")
    val r = ['!', x=32-30, y=18-6, w=60, h=12, anchor='NW']
    loop i in 51 {
        val a = 255 - i*5
        pico.output.clear()
        pico.set.pencil [ color=pico.color.alpha('red', a) ]
        pico.output.draw.rect(r)
        pico.input.delay(10)
        if a == 120 {
            pico.check("blend_raw-03")
        }
    }
}

do {
    print("oval dimming")
    val r = ['!', x=32-30, y=18-6, w=60, h=12, anchor='NW']
    loop i in 51 {
        val a = 255 - i*5
        pico.output.clear()
        pico.set.pencil [ color=pico.color.alpha('red', a) ]
        pico.output.draw.oval(r)
        pico.input.delay(10)
        if a == 120 {
            pico.check("blend_raw-04")
        }
    }
}

do {
    print("tri dimming")
    val p1 = ['!', x=2,  y=12, anchor='NW']
    val p2 = ['!', x=2,  y=24, anchor='NW']
    val p3 = ['!', x=62, y=24, anchor='NW']
    loop i in 51 {
        val a = 255 - i*5
        pico.output.clear()
        pico.set.pencil [ color=pico.color.alpha('red', a) ]
        pico.output.draw.tri(p1, p2, p3)
        pico.input.delay(10)
        if a == 120 {
            pico.check("blend_raw-05")
        }
    }
}

do {
    print("line dimming")
    val p1 = ['!', x=12, y=12, anchor='NW']
    val p2 = ['!', x=52, y=24, anchor='NW']
    loop i in 51 {
        val a = 255 - i*5
        pico.output.clear()
        pico.set.pencil [ color=pico.color.alpha('red', a) ]
        pico.output.draw.line(p1, p2)
        pico.input.delay(10)
        if a == 120 {
            pico.check("blend_raw-06")
        }
    }
}

do {
    print("poly dimming")
    val poly = [
        ['!', x=5,  y=5, anchor='NW'],
        ['!', x=59, y=10, anchor='NW'],
        ['!', x=20, y=31, anchor='NW'],
    ]
    loop i in 51 {
        val a = 255 - i*5
        pico.output.clear()
        pico.set.pencil [ color=pico.color.alpha('red', a) ]
        pico.output.draw.poly(poly)
        pico.input.delay(10)
        if a == 120 {
            pico.check("blend_raw-07")
        }
    }
}

pico.close()
