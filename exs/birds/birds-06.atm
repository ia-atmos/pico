include "../../pico.atm"

pico.open()
pico.set.window [ title="Birds - 06 (pool/scope)" ]
pico.set.dim ['!', w=640, h=480]


val up = pico.layer.image [ path="res/bird-up.png" ]
val dn = pico.layer.image [ path="res/bird-dn.png" ]

math.randomseed(os.time())

task Bird (y, speed) {
    var xx  = 0
    var yy  = y
    var img = dn
    watching until (xx>1) {
        par {
            var ang = 0
            loop us on :clock {
                val v = (speed * us) / 1000
                set xx = xx + (v/1000)
                set yy = y - ((speed * math.sin(ang)) / 5)
                set ang = ang + ((math.pi*v)/100)
                val tmp = ((ang+(math.pi/2)) / math.pi) --> math.floor
                set img = if (tmp%2)==0 => up => dn
            }
        } with {
            loop on :draw {
                pico.output.draw.layer(img, ['%',x=xx,y=yy])
            }
        }
    }
}

loop {
    watching :mouse.button.dn {
        pin birds = tasks(5)
        loop on 500ms {
            spawn @birds Bird(y,s) where {
                y = math.random()
                s = 0.15 + (math.random()/10)
            }
        }
    }
}
