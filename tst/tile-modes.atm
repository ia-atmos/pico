;; §7 (dim, tile) joint resolution: assert texture dim (D) and stored
;; tile (T). Mirrors c/tst/tile-modes.c. Behavioral (no image).

;; known parent frame for '%' cases: world = 100x100
pico.set.dim ['!', w=100, h=100]

func check (key, layer, dw, dh, tw, th) {
    val old = pico.set.layer(layer)
    val v = pico.get.scene()
    print(string.format("%s: dim=%dx%d tile=%dx%d", key, v.dim.w, v.dim.h, v.tile.w, v.tile.h))
    assert(v.dim.w == dw && v.dim.h == dh, "dim mismatch")
    assert(v.tile.w == tw && v.tile.h == th, "tile mismatch")
    pico.set.layer(old)
}

;; G1: tile='#' derives T = floor(D / t)
print("G1: dim='!' + tile='#'")
val g1 = pico.layer.empty [ up=pico.layer.world(), clear=true, dim=['!', w=100, h=100], tile=['#', w=10, h=10] ]
check("g1", g1, 100, 100, 10, 10)

;; G2: tile='%' derives T = floor(t% * D)  ('%' is 0.0-1.0)
print("G2: dim='!' + tile='%'")
val g2 = pico.layer.empty [ up=pico.layer.world(), clear=true, dim=['!', w=100, h=100], tile=['%', w=0.1, h=0.1] ]
check("g2", g2, 100, 100, 10, 10)

;; G3: dim='%' of parent + tile='!'
print("G3: dim='%' + tile='!'")
val g3 = pico.layer.empty [ up=pico.layer.world(), clear=true, dim=['%', w=0.5, h=0.5], tile=['!', w=5, h=5] ]
check("g3", g3, 50, 50, 5, 5)

;; G4: non-divisible -> floor + clip
print("G4: floor (dim%tile != 0)")
val g4 = pico.layer.empty [ up=pico.layer.world(), clear=true, dim=['!', w=100, h=100], tile=['#', w=3, h=3] ]
check("g4", g4, 100, 100, 33, 33)

;; G5: canonical tiled layer, dim='#' cells + bare tile (defaults '!')
print("G5: dim='#' + tile (default '!')")
val g5 = pico.layer.empty [ up=pico.layer.world(), clear=true, dim=['#', w=20, h=15], tile=['!', w=16, h=16] ]
check("g5", g5, 320, 240, 16, 16)

;; G6: set.scene joint (dim='#' + tile='!')
print("G6: set.scene joint dim+tile")
val g6 = pico.layer.empty [ up=pico.layer.world(), clear=true, dim=['!', w=10, h=10] ]
pico.set.layer(g6)
pico.set.scene [ dim=['#', w=8, h=8], tile=['!', w=4, h=4] ]
pico.set.layer(pico.layer.world())
check("g6", g6, 32, 32, 4, 4)

;; G7: set.scene tile-only, resolves against current scene.dim (32x32)
print("G7: set.scene tile-only vs current dim")
pico.set.layer(g6)
pico.set.scene [ tile=['#', w=2, h=2] ]
pico.set.layer(pico.layer.world())
check("g6", g6, 32, 32, 16, 16)

print("ALL OK")
pico.close()
