include "../pico.atm"

pico.open()

val phy = ['!', w=200, h=200]
val log = ['!', w=20, h=20]
pico.set.layer(pico.layer.window())
pico.set.scene [ dim=phy ]
pico.set.layer(pico.layer.world())
pico.set.scene [ dim=log ]

val r = ['%', x=0.5, y=0.5, w=0.5, h=0.5]

print("pos_vs_rect")
;; (`on` is a keyword in Atmos: the Lua variable `on` is `on_`)
loop y in (-1, 10) {
    loop x in (-1, 10) {
        pico.output.clear()
        pico.set.pencil [ color='white' ]
        pico.output.draw.rect(r)

        val p = pico.in.pos(r, ['%', x=x/10.0, y=y/10.0])
        pico.set.pencil [ color='red' ]
        pico.output.draw.pixel(p)

        val on_ = pico.vs.rect.pos(r, p)
        ;;print(if on_ => "in" => "out")

        if x==-1 && y==-1 {
            assert(!on_)
            pico.check("collide_pct-01")
        }
        if x==0 && y==0 {
            assert(on_)
            pico.check("collide_pct-02")
        }
        if x==9 && y==9 {
            assert(on_)
            pico.check("collide_pct-03")
        }
        if x==10 && y==10 {
            assert(!on_)
            pico.check("collide_pct-04")
        }

        pico.input.delay(10)
    }
}

print("rect_vs_rect - same anchor")
;; Lua: `for y = -25, 125, 10` (16 iterations)
loop j in 16 {
    val y = -25 + j*10
    loop i in 16 {
        val x = -25 + i*10
        pico.output.clear()
        pico.set.pencil [ color='white' ]
        pico.output.draw.rect(r)

        val r2 = pico.in.rect(r, ['%', x=x/100.0, y=y/100.0, w=0.5, h=0.5])
        pico.set.pencil [ color='red' ]
        pico.output.draw.rect(r2)

        val overlap = pico.vs.rect.rect(r2, r)
        ;;print(if overlap => "overlap" => "naw")

        if x==-25 && y==-25 {
            assert(!overlap)
            pico.check("collide_pct-05")
        }
        if x==-15 && y==-15 {
            assert(overlap)
            pico.check("collide_pct-06")
        }
        if x==115 && y==115 {
            assert(overlap)
            pico.check("collide_pct-07")
        }
        if x==125 && y==125 {
            assert(!overlap)
            pico.check("collide_pct-08")
        }

        pico.input.delay(10)
    }
}

print("rect_vs_rect - diff anchor")
loop y in (-5, 10) {
    loop x in (-5, 10) {
        pico.output.clear()
        pico.set.pencil [ color='white' ]
        pico.output.draw.rect(r)

        val r2 = pico.in.rect(r, ['%', x=x/10.0, y=y/10.0, w=0.5, h=0.5, anchor='NW'])
        pico.set.pencil [ color='red' ]
        pico.output.draw.rect(r2)

        val overlap = pico.vs.rect.rect(r2, r)
        ;;print(if overlap => "overlap" => "naw")

        if x==-5 && y==-5 {
            assert(!overlap)
            pico.check("collide_pct-09")
        }
        if x==-4 && y==-4 {
            assert(overlap)
            pico.check("collide_pct-10")
        }
        if x==9 && y==9 {
            assert(overlap)
            pico.check("collide_pct-11")
        }
        if x==10 && y==10 {
            assert(!overlap)
            pico.check("collide_pct-12")
        }

        pico.input.delay(10)
    }
}

pico.close()
