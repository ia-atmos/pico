        pico_output_sound_path(A_STR_OF(v)->s);
    } else {
        _PICO_ATMOS_Res* r;
        _PICO_ATMOS_TRY(_pico_atmos_res(v, _PICO_ATMOS_KIND_SND, &r));
        pico_output_sound(r->ptr);
    }
    return A_OK;
}

///////////////////////////////////////////////////////////////////////////////
// TESTS
///////////////////////////////////////////////////////////////////////////////

// pico.equal(a, b): the numbers are close enough
static AStatus _pico_atmos_l_equal (AFunc* self, int argc, AVal* argv) {
    _PICO_ATMOS_IN0("equal")
    AVal a = _PICO_ATMOS_ARG(0);
    AVal b = _PICO_ATMOS_ARG(1);
    if (!a_isnum(a) || !a_isnum(b)) {
        return _pico_atmos_bad(a_isnum(a) ? 1 : 0, "number", a_isnum(a) ? b : a);
    }
    a_push(a_bool(fabs(a_dbl(a) - a_dbl(b)) < 0.001));
    return A_OK;
}

static int _pico_atmos_env (const char* name) {
    const char* v = getenv(name);
    return v!=NULL && v[0]!='\0';
}

// The files exist and have the same contents.
static int _pico_atmos_same (const char* path1, const char* path2) {
    FILE* f1 = fopen(path1, "rb");
    FILE* f2 = fopen(path2, "rb");
    int ok = (f1!=NULL && f2!=NULL);
    while (ok) {
        char b1[4096], b2[4096];
        size_t n1 = fread(b1, 1, sizeof(b1), f1);
        size_t n2 = fread(b2, 1, sizeof(b2), f2);
        ok = (n1==n2 && memcmp(b1,b2,n1)==0);
        if (n1 < sizeof(b1)) {
            break;
        }
    }
    if (f1 != NULL) { fclose(f1); }
    if (f2 != NULL) { fclose(f2); }
    return ok;
}

// pico.check(name): saves the window to `<tst>/out/<name>.png`, and
// compares it with `<tst>/asr/<name>.png` if PICO_CHECK_ASR is set.
// `<tst>` is `<PICO_ROOT>/c/tst` (`tst/run.sh` sets PICO_ROOT to the root
// of the repository), or `../c/tst` if the variable is not set.
static AStatus _pico_atmos_l_check (AFunc* self, int argc, AVal* argv) {
    _PICO_ATMOS_IN("check")
    const char* name;
    _PICO_ATMOS_TRY(_pico_atmos_str(_PICO_ATMOS_ARG(0), 0, &name));
    char tst[1024], dir[1100], out[2048], asr[2048];
    if (_pico_atmos_env("PICO_ROOT")) {
        snprintf(tst, sizeof(tst), "%s/c/tst", getenv("PICO_ROOT"));
    } else {
        snprintf(tst, sizeof(tst), "../c/tst");
    }
    snprintf(dir, sizeof(dir), "%s/out", tst);
    snprintf(out, sizeof(out), "%s/out/%s.png", tst, name);
    snprintf(asr, sizeof(asr), "%s/asr/%s.png", tst, name);
    mkdir(dir, 0777);
    _PICO_ATMOS_TRY(_pico_atmos_file(dir));
    pico_output_screenshot(pico_layer_window(), out, NULL);
    printf("Testing: %s\n", name);
    if (_pico_atmos_env("PICO_CHECK_INT")) {
        puts("-=- press any key -=-");
        fflush(stdout);
        pico_input_event(NULL, PICO_EVENT_KEY_DN);
    }
    if (_pico_atmos_env("PICO_CHECK_ASR") && !_pico_atmos_same(out, asr)) {
        snprintf(asr, sizeof(asr), "%s/asr/%s-CI.png", tst, name);
        if (!_pico_atmos_same(out, asr)) {
            return a_error("FAIL: %s", name);
        }
    }
    return A_OK;
}

///////////////////////////////////////////////////////////////////////////////
// ENVIRONMENT
///////////////////////////////////////////////////////////////////////////////

static AStatus _pico_atmos_emit_tag (const char* tag, int tab) {
    AVal t = a_strz(tag);
    AVal evt = t;
    if (tab) {
        evt = a_tab();
        a_tag(evt, t);
        a_dec(t);
    }
    AStatus st = atm_emit(evt);
    a_dec(evt);
    return st;
}

// Test script: an entry `dn:x:y`, `up:x:y`, or `mv:x:y` of PICO_ATM_MOUSE.
// The event has the mouse as a real event has it: in pixels of the window,
// with the anchor 'C'.
static AStatus _pico_atmos_script_mouse (const char* arg) {
    int x, y;
    char k[3], end;
    int id = PICO_EVENT_NONE;
    if (sscanf(arg, "%2[a-z]:%d:%d%c", k, &x, &y, &end) == 3) {
        id = !strcmp(k,"dn") ? PICO_EVENT_MOUSE_BUTTON_DN
           : !strcmp(k,"up") ? PICO_EVENT_MOUSE_BUTTON_UP
           : !strcmp(k,"mv") ? PICO_EVENT_MOUSE_MOTION
           : PICO_EVENT_NONE;
    }
    if (id == PICO_EVENT_NONE) {
        return a_error("PICO_ATM_MOUSE : invalid entry \"%s\"", arg);
    }
    _PICO_ATMOS.mouse.on = 1;
    _PICO_ATMOS.mouse.x  = x;
    _PICO_ATMOS.mouse.y  = y;
    if (id != PICO_EVENT_MOUSE_MOTION) {
        _PICO_ATMOS.mouse.left = (id == PICO_EVENT_MOUSE_BUTTON_DN);
    }
    Pico_Event e = { .type=id };
    Pico_Rel_Pos pos = { .mode='!', .anchor=PICO_ANCHOR_C };
    e.mouse = _pico_atmos_mouse(pico_layer_window(), &pos);
    AVal evt = _pico_atmos_mk_event(&e);
    AStatus st = atm_emit(evt);
    a_dec(evt);
    return st;
}

// Test script: the entries `frame:...` of a variable that are due.
static AStatus _pico_atmos_script (const char* var, int frame) {
    AStatus st = A_OK;
    const char* s = getenv(var);
    while (s!=NULL && *s!='\0' && st==A_OK && _PICO_ATMOS.open) {
        char item[512];
        size_t n = strcspn(s, ",");
        snprintf(item, sizeof(item), "%.*s", (int)n, s);
        s += n + (s[n] == ',');
        char* arg = strchr(item, ':');
        if (!strcmp(var,"PICO_ATM_MOUSE") && arg!=NULL && atoi(item)==frame) {
            st = _pico_atmos_script_mouse(arg+1);
            continue;
        }
        if (arg==NULL || atoi(item)!=frame) {
            continue;
        }
        arg++;
        if (!strcmp(var, "PICO_ATM_SHOT")) {
            pico_output_screenshot(pico_layer_window(), arg, NULL);
        } else if (!strncmp(arg,"dn:",3) || !strncmp(arg,"up:",3)) {
            AVal e = a_tab();
            AVal tag = a_strz((arg[0] == 'd') ? "key.dn" : "key.up");
            a_tag(e, tag);
            a_dec(tag);
            _pico_atmos_set(e, "key",   a_strz(arg+3));
            _pico_atmos_set(e, "ctrl",  a_bool(0));
            _pico_atmos_set(e, "shift", a_bool(0));
            _pico_atmos_set(e, "alt",   a_bool(0));
            st = atm_emit(e);
            a_dec(e);
        }
    }
    return st;
}

// The loop of pico: one frame per iteration.
static AStatus _pico_atmos_loop (void) {
    AStatus st = A_OK;

    // test mode: a fixed number of frames with a fixed duration
    int frames = -1;
    int fixed  = 0;
    if (_pico_atmos_env("PICO_ATM_FRAMES")) {
        sscanf(getenv("PICO_ATM_FRAMES"), "%d:%d", &frames, &fixed);
    }

    if (!pico_get_expert(NULL)) {
        pico_set_expert(1, 30);
    }

    Uint32 prv = pico_get_now();
    for (int frame=1; st==A_OK && _PICO_ATMOS.open && atm_alive(); frame++) {
        // input
        Pico_Event e;
        if (fixed > 0) {
            pico_input_event_timeout(&e, PICO_EVENT_ANY, 0);
        } else {
            pico_input_event(&e, PICO_EVENT_ANY);
        }

        // time
        Uint32 now = pico_get_now();
        int ms = (fixed > 0) ? fixed : (int)(now - prv);
        prv = now;
        if (ms > 0) {
            st = atm_emit(a_int((int64_t)ms * 1000));
        }

        // event
        if (st==A_OK && e.type!=PICO_EVENT_NONE) {
            AVal evt = _pico_atmos_mk_event(&e);
            if (e.type==PICO_EVENT_MOUSE_MOTION ||
                e.type==PICO_EVENT_MOUSE_BUTTON_DN ||
                e.type==PICO_EVENT_MOUSE_BUTTON_UP) {
                _PICO_ATMOS.mouse.on = 0;    // the real mouse is back
            }
            st = atm_emit(evt);
            a_dec(evt);
            if (e.type == PICO_EVENT_QUIT) {
                break;
            }
        }
        if (st == A_OK) {
            st = _pico_atmos_script("PICO_ATM_KEYS", frame);
        }
        if (st == A_OK) {
            st = _pico_atmos_script("PICO_ATM_MOUSE", frame);
        }

        // screen
        if (st==A_OK && _PICO_ATMOS.open) {
            // always the world, whatever the current layer is
            Pico_Layer* cur = pico_set_layer(pico_layer_world());
            pico_output_clear();
            pico_set_layer(cur);
            st = _pico_atmos_emit_tag("draw", 0);
        }
        if (st==A_OK && _PICO_ATMOS.open) {
            pico_output_present(1);
            _pico_atmos_script("PICO_ATM_SHOT", frame);
        }

        if (st==A_OK && frames>0 && frame>=frames) {
            st = _pico_atmos_emit_tag("quit", 1);
            break;
        }
    }
    return st;
}

int main (int argc, char** argv) {
    atm_init(argc, argv);

    // pico is open, with the default window, when the program starts
    _pico_atmos_open(NULL);

    AStatus st = atm_main();
    if (st==A_OK && _PICO_ATMOS.open && atm_alive()) {
        st = _pico_atmos_loop();
    }
    if (st == A_OK) {
        st = atm_stop();
    }
    fflush(stdout);
    if (st == A_ESCAPE) {
        st = a_escape_err();
    }
    if (st != A_OK) {
        a_error_dump();
    }

    // from now on, the values that the program still holds are only
    // released in memory: `pico_close` frees what is alive in pico
    _PICO_ATMOS.closing = 1;
    _pico_atmos_release();
    atm_quit();
    if (_PICO_ATMOS.open) {
        _PICO_ATMOS.open = 0;
        pico_close();
    }
    return (st == A_OK) ? 0 : 1;
}
```

val pico = [
    ;; pico.open([title=, fs=, show=]): opens pico and its window again,
    ;; after a `pico.close()`: the program starts with pico open
    ;; (`fs` may also be named `fullscreen`)
    open  = `:value a_func(_pico_atmos_l_open,  0)`,
    ;; pico.close(): closes pico, and invalidates all layers, fonts, sounds
    close = `:value a_func(_pico_atmos_l_close, 0)`,
    ;; pico.quit(): pushes a quit event
    quit  = `:value a_func(_pico_atmos_l_quit,  0)`,

    ;; pico.check(name), pico.equal(a, b): helpers of the visual tests
    check = `:value a_func(_pico_atmos_l_check, 0)`,
    equal = `:value a_func(_pico_atmos_l_equal, 0)`,

    ;; pico.color.*(clr, ...): a new color [r=, g=, b=, a=]
    color = [
        alpha   = `:value a_func(_pico_atmos_l_color_alpha,   0)`,  ;; (clr, a)
        darker  = `:value a_func(_pico_atmos_l_color_darker,  0)`,  ;; (clr, pct)
        lighter = `:value a_func(_pico_atmos_l_color_lighter, 0)`,  ;; (clr, pct)
        mix     = `:value a_func(_pico_atmos_l_color_mix,     0)`,  ;; (c1, c2)
    ],

    ;; pico.cv.*([L_to,] to|mode, [L_fr,] fr): projects `fr` from the layer
    ;; `L_fr` into the layer `L_to` (nil is the current one). The result
    ;; fills the table `to`, or is a new value in the given mode.
    cv = [
        dim  = `:value a_func(_pico_atmos_l_cv_dim,  0)`,
        pos  = `:value a_func(_pico_atmos_l_cv_pos,  0)`,
        rect = `:value a_func(_pico_atmos_l_cv_rect, 0)`,
    ],

    ;; pico.in.*(out, in): composes `in` onto the rect `out`
    in = [
        dim  = `:value a_func(_pico_atmos_l_in_dim,  0)`,
        pos  = `:value a_func(_pico_atmos_l_in_pos,  0)`,
        rect = `:value a_func(_pico_atmos_l_in_rect, 0)`,
    ],

    ;; pico.vs.A.B([L1,] v1, [L2,] v2): collision between two values, each
    ;; in a layer (nil is the current one). A missing rect is the bounds of
    ;; its layer.
    vs = [
        pos = [
            pos  = `:value a_func(_pico_atmos_l_vs_pos_pos,  0)`,
            rect = `:value a_func(_pico_atmos_l_vs_pos_rect, 0)`,
        ],
        rect = [
            pos  = `:value a_func(_pico_atmos_l_vs_rect_pos,  0)`,
            rect = `:value a_func(_pico_atmos_l_vs_rect_rect, 0)`,
        ],
    ],

    get = [
        aids     = `:value a_func(_pico_atmos_l_get_aids,     0)`,  ;; () -> boolean
        effect   = `:value a_func(_pico_atmos_l_get_effect,   0)`,  ;; () -> [alpha=, color=, flip=, grid=, rotate=]
        expert   = `:value a_func(_pico_atmos_l_get_expert,   0)`,  ;; () -> boolean, fps
        image    = `:value a_func(_pico_atmos_l_get_image,    0)`,  ;; ([dim|mode,] path) -> Dim
        keyboard = `:value a_func(_pico_atmos_l_get_keyboard, 0)`,  ;; () -> [key='', ctrl=, shift=, alt=]
        layer    = `:value a_func(_pico_atmos_l_get_layer,    0)`,  ;; () -> layer
        mouse    = `:value a_func(_pico_atmos_l_get_mouse,    0)`,  ;; ([layer,] mode|pos) -> Mouse
        now      = `:value a_func(_pico_atmos_l_get_now,      0)`,  ;; () -> ms
        pencil   = `:value a_func(_pico_atmos_l_get_pencil,   0)`,  ;; () -> [color=, font=, style=]
        scene    = `:value a_func(_pico_atmos_l_get_scene,    0)`,  ;; () -> [dim=, tile=, target=, source=, clip=, clear=]
        text     = `:value a_func(_pico_atmos_l_get_text,     0)`,  ;; (dim, text) -> Dim
        video    = `:value a_func(_pico_atmos_l_get_video,    0)`,  ;; ([rect|mode,] layer|path) -> [dim=, fps=, frame=, done=]
        window   = `:value a_func(_pico_atmos_l_get_window,   0)`,  ;; () -> [fullscreen=, show=, title=]
    ],

    ;; omitted fields keep their current values
    set = [
        aids   = `:value a_func(_pico_atmos_l_set_aids,   0)`,  ;; (on)
        dim    = `:value a_func(_pico_atmos_l_set_dim,    0)`,  ;; (dim): window and world
        effect = `:value a_func(_pico_atmos_l_set_effect, 0)`,  ;; [alpha=, color=, flip=, grid=, rotate=[angle=,anchor=]]
        expert = `:value a_func(_pico_atmos_l_set_expert, 0)`,  ;; (on [, fps]) -> ms of a frame
        layer  = `:value a_func(_pico_atmos_l_set_layer,  0)`,  ;; (layer) -> the previous one
        mouse  = `:value a_func(_pico_atmos_l_set_mouse,  0)`,  ;; ([layer,] pos)
        ;; font: a font, a path, or true (the built-in font)
        pencil = `:value a_func(_pico_atmos_l_set_pencil, 0)`,  ;; [color=, font=, style='fill'|'stroke']
        scene  = `:value a_func(_pico_atmos_l_set_scene,  0)`,  ;; [dim=, tile=, target=, source=, clip=, clear=]
        video  = `:value a_func(_pico_atmos_l_set_video,  0)`,  ;; (layer, frame) -> boolean
        window = `:value a_func(_pico_atmos_l_set_window, 0)`,  ;; [fullscreen=, show=, title=]
    ],

    ;; Each constructor evaluates to a new layer:
    ;;  - up: the parent to attach it to (default: detached)
    ;;  - target: its placement in the parent (default: all of it)
    layer = [
        world      = `:value a_func(_pico_atmos_l_layer_world,      0)`,  ;; ()
        window     = `:value a_func(_pico_atmos_l_layer_window,     0)`,  ;; ()
        empty      = `:value a_func(_pico_atmos_l_layer_empty,      0)`,  ;; [up=, clear=, dim=, tile=, target=]
        image      = `:value a_func(_pico_atmos_l_layer_image,      0)`,  ;; [up=, path=, target=]
        ;; a table with the sub-layers of a sprite sheet:
        ;;  - sheet=['#', w=cols, h=rows, n=count]: a vector, left to right
        ;;  - sheet=['!', name=Rect, ...]: a table with the same names
        ;;  - target: the placement of every sub-layer (all the same)
        images     = `:value a_func(_pico_atmos_l_layer_images,     0)`,  ;; [up=, path=, sheet=, target=]
        ;; `pixels` may also be named `pixmap`
        pixmap     = `:value a_func(_pico_atmos_l_layer_pixmap,     0)`,  ;; [up=, pixels=, target=]
        ;; `sup` and `crop` may also be named `src` and `rect`
        screenshot = `:value a_func(_pico_atmos_l_layer_screenshot, 0)`,  ;; [up=, sup=, crop=, target=]
        sub        = `:value a_func(_pico_atmos_l_layer_sub,        0)`,  ;; [up=, sup=, crop=, target=]
        text       = `:value a_func(_pico_atmos_l_layer_text,       0)`,  ;; [up=, dim=, text=, target=]
        video      = `:value a_func(_pico_atmos_l_layer_video,      0)`,  ;; [up=, path=, target=]
    ],

    font = [
        load = `:value a_func(_pico_atmos_l_font_load, 0)`,     ;; (path) -> font
    ],

    sound = [
        load = `:value a_func(_pico_atmos_l_sound_load, 0)`,    ;; (path) -> sound
    ],

    input = [
        delay = `:value a_func(_pico_atmos_l_input_delay, 0)`,  ;; (ms) -> ms passed
        ;; () | (ms) | (filter [, ms]) -> event|nil, ms passed
        ;;  - filter: 'quit', 'key.dn', 'key.up', 'mouse.motion',
        ;;    'mouse.button.dn', 'mouse.button.up', 'window.resize', or nil
        ;;    for any event
        ;;  - ms: an integer >= 0, or nil (or -1) for no timeout
        ;;  - any other type for the two is an error
        event = `:value a_func(_pico_atmos_l_input_event, 0)`,
        loop  = `:value a_func(_pico_atmos_l_input_loop,  0)`,  ;; (): until the window closes
    ],

    output = [
        clear      = `:value a_func(_pico_atmos_l_output_clear,      0)`,  ;; ()
        present    = `:value a_func(_pico_atmos_l_output_present,    0)`,  ;; ([layers])
        screenshot = `:value a_func(_pico_atmos_l_output_screenshot, 0)`,  ;; ([layer [, path] [, rect]]) -> path
        sound      = `:value a_func(_pico_atmos_l_output_sound,      0)`,  ;; (sound|path)
        draw = [
            image  = `:value a_func(_pico_atmos_l_output_draw_image,  0)`,  ;; (path, rect)
            layer  = `:value a_func(_pico_atmos_l_output_draw_layer,  0)`,  ;; (layer [, rect])
            layers = `:value a_func(_pico_atmos_l_output_draw_layers, 0)`,  ;; ()
            line   = `:value a_func(_pico_atmos_l_output_draw_line,   0)`,  ;; (p1, p2)
            oval   = `:value a_func(_pico_atmos_l_output_draw_oval,   0)`,  ;; (rect)
            pixel  = `:value a_func(_pico_atmos_l_output_draw_pixel,  0)`,  ;; (pos)
            pixels = `:value a_func(_pico_atmos_l_output_draw_pixels, 0)`,  ;; (ps)
            poly   = `:value a_func(_pico_atmos_l_output_draw_poly,   0)`,  ;; (ps)
            rect   = `:value a_func(_pico_atmos_l_output_draw_rect,   0)`,  ;; (rect)
            text   = `:value a_func(_pico_atmos_l_output_draw_text,   0)`,  ;; (text, rect)
            tri    = `:value a_func(_pico_atmos_l_output_draw_tri,    0)`,  ;; (p1, p2, p3)
            video  = `:value a_func(_pico_atmos_l_output_draw_video,  0)`,  ;; (path, rect) -> boolean
        ],
    ],
]
