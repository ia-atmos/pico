;; pico.atm: the Atmos binding and environment for pico-sdl.
;;
;;      atmos-pico game.atm         ;; builds and runs
;;
;; `atmos-pico` is the Atmos compiler dedicated to pico (see the Makefile):
;; it includes this file before the program, such that the table `pico` is
;; available from its first line, and links the C library. A program may
;; also include this file itself and use the plain compiler, with the flags
;; of the Makefile in ATMOS_CFLAGS and ATMOS_LDFLAGS (an `include` under
;; `atmos-pico` is harmless: a file is only included once).
;;
;; A program starts with pico open, with the default window: `main` opens it
;; before the main chunk runs, and closes it when the program terminates.
;; `pico.close()` closes it earlier, and `pico.open([...])` is only valid
;; after a `pico.close()`, to open pico again (this is how a program gets a
;; window that is hidden or in fullscreen from its creation; otherwise, see
;; `pico.set.window`). All operations, except `pico.open`, `pico.color.*`,
;; and `pico.equal`, raise an error while pico is closed.
;;
;; Everything lives in the single table `pico`, with the names of the C
;; library split at the underscores:
;;
;;      pico_output_draw_rect(r)  -->  pico.output.draw.rect(r)
;;      pico_set_pencil_color(c)  -->  pico.set.pencil [color=c]
;;
;; VALUES
;;
;;      Rect    ['%', x=, y=, w=, h=, anchor=]  mode at index 0: '!' pixels,
;;      Pos     ['%', x=, y=, anchor=]          '%' percentage, '#' tiles;
;;      Dim     ['%', w=, h=]                   a missing w/h is inferred
;;      Anchor  'C' 'NW' 'N' 'NE' 'E' 'SE' 'S' 'SW' 'W', or [x=,y=]
;;      Color   'red', 0xRRGGBB, 0xRRGGBBAA, or ['!'|'%', r=, g=, b=, a=]
;;
;; The names of colors are 'black' 'white' 'gray' 'silver' 'red' 'green'
;; 'blue' 'yellow' 'cyan' 'magenta' 'orange' 'purple' 'pink' 'brown' 'lime'
;; 'teal' 'navy' 'maroon' 'olive', and 'transparent' (alpha 0).
;;
;; The values that the operations return are not symmetric with the ones they
;; accept: an anchor is always a table [x=,y=] ('C' comes back as
;; [x=0.5,y=0.5]), and a color is always [r=,g=,b=,a=] with integers from 0
;; to 255 and no mode at index 0. Both are valid as arguments.
;;
;; Some fields have a second name: `fullscreen=` for `fs=` in `pico.open`,
;; `pixmap=` for `pixels=` in `pico.layer.pixmap`, and `src=` and `rect=` for
;; `sup=` and `crop=` in `pico.layer.screenshot`. The first name prevails if
;; both are given.
;;
;; The field `font` of `pico.set.pencil` is a font, the path of a TTF file,
;; or `true` for the built-in font. The built-in font comes back as `nil` in
;; `pico.get.pencil().font`.
;;
;; `pico.get.keyboard()` polls the modifiers only: its `key` is always the
;; empty string (the key itself only comes in the events `:key.dn`/`:key.up`).
;;
;; LAYERS, FONTS, AND SOUNDS are native values:
;;
;;      val l = pico.layer.empty [dim=['!',w=32,h=32]]
;;      val f = pico.font.load("x.ttf")
;;      val s = pico.sound.load("x.wav")
;;
;; A resource lives as long as its value is referenced: it is released with
;; its last reference, or with its `pin` block. There is no explicit `free`:
;; to release a resource, drop its value (`set l = nil`) or declare it in a
;; block that ends.
;; Therefore, a layer attached to a parent (`up=`) must be kept somewhere: if
;; its value is dropped, the layer is released and disappears from the screen.
;;
;; What a resource depends on outlives it: the parent of a layer (`up`), the
;; source of a sub-layer (`sup`), the current layer (`pico.set.layer`), and
;; the font of a pencil. If such a value is dropped, or pinned in a block that
;; ends first, its release is postponed until nothing depends on it (and
;; `pico.get.layer()` or `pico.get.pencil().font` evaluate to `nil` if the
;; value is gone).
;;
;; A plain `val` is enough to hold a resource. A resource in a `pin` cannot
;; go into a table argument (`[up=l]`) unless the table is also pinned, as for
;; any pinned value:
;;
;;      pin l = pico.layer.empty [...]
;;      pin t = [up=l, dim=...]
;;      val x = pico.layer.empty(t)
;;
;; `pico.close()` releases all resources: every value from before it is
;; invalid afterwards, even after a new `pico.open()`, and any use raises an
;; error.
;; `pico.layer.world()` and `pico.layer.window()` evaluate to the two root
;; layers, always as the same shared values, which cannot be pinned.
;;
;; IMPERATIVE PROGRAMS draw, wait for input with `pico.input.*`, and call
;; `pico.close()` (or leave it to the end of the program).
;;
;; `pico.input.event` evaluates to the event (or nil on a timeout) and to the
;; time passed in milliseconds, and accepts these forms:
;;
;;      pico.input.event()              any event, no timeout
;;      pico.input.event(ms)            any event, up to `ms`
;;      pico.input.event(filter)        only the given event, no timeout
;;      pico.input.event(filter, ms)    only the given event, up to `ms`
;;
;; `filter` is the name of an event ('quit', 'key.dn', ...) or nil for any
;; event. `ms` is an integer (a number with no fractional part) from 0, or
;; nil or -1 for no timeout. Anything else is an error: an argument of
;; another type, a number where the filter goes if `ms` is also given, an
;; unknown name, or a timeout below -1. Arguments after the second are
;; ignored, as in the other functions.
;;
;; REACTIVE PROGRAMS await. When the main chunk awaits
;; (it does not terminate) and pico is open, the program runs inside the loop
;; of pico, which runs in expert mode and leaves it on:
;;
;;  - If the expert mode is off when the loop starts, the loop turns it on at
;;    30 fps.
;;  - If the program has turned it on, the loop keeps its setting:
;;    `pico.set.expert(true,fps)` runs at `fps`, and `pico.set.expert(true)`,
;;    with no fps, makes each frame wait for an input event with no timeout:
;;    with no events there are no frames, the time does not advance
;;    (`await 1s` does not awake), and nothing is redrawn.
;;
;; A frame ends at its deadline or as soon as a real input event arrives, so
;; that the fps is the minimum rate: each event has a frame (and a `:draw`) of
;; its own.
;;
;; The loop emits, once per frame and in this order:
;;
;;      <number>                the time passed, in microseconds, so that
;;                              `await 1s` and `loop dt on :clock` work;
;;                              not emitted in a frame in which 0ms passed
;;      :quit []                the window was closed: the loop terminates
;;      :key.dn [key='A', ctrl=, shift=, alt=]
;;      :key.up [...]
;;      :mouse.motion    ['!', x=, y=, anchor=, left=, right=, middle=]
;;      :mouse.button.dn [...]
;;      :mouse.button.up [...]
;;      :window.resize [w=, h=]
;;      :draw                   to redraw the screen, between a clear and a
;;                              present
;;
;; The clear of a frame always applies to the world layer, whatever the
;; current layer is when the program awaits (which the loop keeps as the
;; current one). As any clear, it cascades to the descendants of the world
;; created with `clear=true`: the other layers keep what was drawn on them.
;;
;; At most one real input event is emitted per frame (the others wait for the
;; next frames). The scripted events of PICO_ATM_KEYS and PICO_ATM_MOUSE
;; (below) are emitted in addition, after the real one and before `:draw`: all
;; the entries of a frame, the keys first, each list in its order. The loop
;; terminates with `:quit`, with the program, or with `pico.close()`.
;;
;; TESTS with no interaction:
;;
;;      PICO_ATM_FRAMES=n:ms        runs `n` frames, then emits `:quit`; if
;;                                  `ms` is not 0, each frame lasts exactly
;;                                  `ms` milliseconds and does not wait
;;                                  (with `ms` 0, the frames are the real
;;                                  ones: see `pico.set.expert(true)` above)
;;      PICO_ATM_KEYS=f:dn:A,...    presses (dn) or releases (up) keys at frames
;;      PICO_ATM_MOUSE=f:dn:x:y,... presses (dn) or releases (up) the left
;;                                  button, or only moves the mouse (mv), at
;;                                  the pixel (x,y) of the window, at frames
;;      PICO_ATM_SHOT=f:x.png,...   saves the window at frames
;;
;; An entry of PICO_ATM_MOUSE emits one `:mouse.button.dn`, `:mouse.button.up`,
;; or `:mouse.motion`, as a real event: ['!', x=, y=, anchor=[x=0.5,y=0.5],
;; left=, right=false, middle=false], in pixels of the window (a `dn` or `up`
;; does not emit a motion before it). From then on, `pico.get.mouse` answers
;; with the scripted position and left button, in any layer and mode, until a
;; real mouse event arrives or the program calls `pico.set.mouse`. The real
;; cursor does not move. An invalid entry is an error at its frame.
;;
;; `pico.check(name)` and `pico.equal(a,b)` are the helpers of the visual
;; tests (PICO_CHECK_INT, PICO_CHECK_ASR). `pico.check` uses the directories
;; `c/tst/out` and `c/tst/asr` under PICO_ROOT, the absolute root of pico,
;; which `tst/run.sh` exports. If the variable is not set, they are
;; `../c/tst/out` and `../c/tst/asr`, relative to the current directory.

```:prelude
#include <math.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/stat.h>
#include "pico.h"

///////////////////////////////////////////////////////////////////////////////
// STATE
///////////////////////////////////////////////////////////////////////////////

// A font or a sound. The struct is shared by the box and by what
// depends on it (a pencil), so it outlives a box that is pinned.
typedef struct _PICO_ATMOS_Res {
    void* ptr;
    int   gen;          // generation of the `pico.open` that created it
    int   rc;
    int   font;         // font or sound
} _PICO_ATMOS_Res;

enum {
    _PICO_ATMOS_ROOT, _PICO_ATMOS_EMPTY, _PICO_ATMOS_IMAGE, _PICO_ATMOS_PIXMAP, _PICO_ATMOS_SHOT, _PICO_ATMOS_SUB, _PICO_ATMOS_TEXT, _PICO_ATMOS_VIDEO
};

// A layer. The struct is shared by the box and by what depends on it:
// children, sub-layers, and the binding itself for the current layer.
typedef struct _PICO_ATMOS_Lay {
    Pico_Layer*    lay;
    int            gen;
    int            rc;
    int            kind;
    int            subs;    // live sub-layers that borrow its texture
    struct _PICO_ATMOS_Lay* up;      // parent it is attached to
    struct _PICO_ATMOS_Lay* sup;     // source of a sub-layer
    AVal           font;    // font of its pencil, as set: box, path, or nil
    _PICO_ATMOS_Res*        fres;    // the struct of that box
} _PICO_ATMOS_Lay;

static struct {
    int     open;
    int     gen;            // incremented at every `pico.open`
    int     closing;        // the program terminates: no more calls to pico
    _PICO_ATMOS_Lay* cur;
    AVal    cur_box;
    AVal    world;
    AVal    window;
    struct {                // mouse of PICO_ATM_MOUSE, in window pixels,
        int on;             // which replaces the real one from an entry
        int x, y;           // until a real mouse event or `pico.set.mouse`
        int left;
    } mouse;
} _PICO_ATMOS;

static const char* _PICO_ATMOS_FN = "pico";      // function being executed

static const char* _PICO_ATMOS_KIND_LAY = "pico.layer";
static const char* _PICO_ATMOS_KIND_FNT = "pico.font";
static const char* _PICO_ATMOS_KIND_SND = "pico.sound";

#define _PICO_ATMOS_ARG(i) (((i) < argc) ? argv[i] : a_nil())
#define _PICO_ATMOS_TRY(x) do { if (!(x)) return A_ERROR; } while (0)
#define _PICO_ATMOS_IN0(name)                                                    \
    (void) self; (void) argc; (void) argv;                              \
    _PICO_ATMOS_FN = "pico." name;
#define _PICO_ATMOS_IN(name)                                                     \
    _PICO_ATMOS_IN0(name)                                                        \
    if (!_PICO_ATMOS.open) {                                                     \
        return a_error("%s : pico is not open", _PICO_ATMOS_FN);                 \
    }

static int _pico_atmos_live (int gen) {
    return _PICO_ATMOS.open && !_PICO_ATMOS.closing && gen==_PICO_ATMOS.gen;
}

///////////////////////////////////////////////////////////////////////////////
// RESOURCES
///////////////////////////////////////////////////////////////////////////////

static void _pico_atmos_res_unref (_PICO_ATMOS_Res* r) {
    if (r==NULL || --r->rc>0) {
        return;
    }
    if (_pico_atmos_live(r->gen)) {
        if (r->font) {
            pico_font_free(r->ptr);
        } else {
            pico_sound_free(r->ptr);
        }
    }
    free(r);
}

static void _pico_atmos_res_fin (void* p) {
    _pico_atmos_res_unref(p);
}

static AVal _pico_atmos_res_new (void* ptr, int font) {
    _PICO_ATMOS_Res* r = malloc(sizeof(_PICO_ATMOS_Res));
    *r = (_PICO_ATMOS_Res) { ptr, _PICO_ATMOS.gen, 1, font };
    return a_nat(r, _pico_atmos_res_fin, font ? _PICO_ATMOS_KIND_FNT : _PICO_ATMOS_KIND_SND);
}

static void _pico_atmos_lay_unref (_PICO_ATMOS_Lay* s) {
    while (s!=NULL && --s->rc==0) {
        if (s->kind!=_PICO_ATMOS_ROOT && _pico_atmos_live(s->gen)) {
            pico_layer_free(s->lay);
        }
        _PICO_ATMOS_Lay* up  = s->up;
        _PICO_ATMOS_Lay* sup = s->sup;
        if (sup != NULL) {
            sup->subs--;
        }
        _pico_atmos_res_unref(s->fres);
        a_dec(s->font);
        free(s);
        _pico_atmos_lay_unref(sup);
        s = up;
    }
}

static void _pico_atmos_lay_fin (void* p) {
    _pico_atmos_lay_unref(p);
}

static AVal _pico_atmos_lay_new (Pico_Layer* lay, int kind, _PICO_ATMOS_Lay* up, _PICO_ATMOS_Lay* sup) {
    _PICO_ATMOS_Lay* s = malloc(sizeof(_PICO_ATMOS_Lay));
    *s = (_PICO_ATMOS_Lay) { lay, _PICO_ATMOS.gen, 1, kind, 0, up, sup, a_nil(), NULL };
    if (up != NULL) {
        up->rc++;
    }
    if (sup != NULL) {
        sup->rc++;
        sup->subs++;
    }
    return a_nat(s, _pico_atmos_lay_fin, _PICO_ATMOS_KIND_LAY);
}

// Sets the box of the current layer.
static void _pico_atmos_cur (AVal box) {
    _PICO_ATMOS_Lay* old = _PICO_ATMOS.cur;
    _PICO_ATMOS.cur = a_nat_ptr(box);
    _PICO_ATMOS.cur->rc++;
    a_cpy(&_PICO_ATMOS.cur_box, box);
    _pico_atmos_lay_unref(old);
}

// Releases what the binding holds. The layers themselves go with pico.
static void _pico_atmos_release (void) {
    _PICO_ATMOS_Lay* cur = _PICO_ATMOS.cur;
    _PICO_ATMOS.cur = NULL;
    a_clr(&_PICO_ATMOS.cur_box);
    a_clr(&_PICO_ATMOS.world);
    a_clr(&_PICO_ATMOS.window);
    _pico_atmos_lay_unref(cur);
}

static void _pico_atmos_close (void) {
    _PICO_ATMOS.open = 0;
    _pico_atmos_release();
    pico_close();
}

///////////////////////////////////////////////////////////////////////////////
// ARGUMENTS
///////////////////////////////////////////////////////////////////////////////

static AStatus _pico_atmos_bad (int i, const char* exp, AVal got) {
    return a_error("%s : bad argument #%d (%s expected, got %s)",
        _PICO_ATMOS_FN, i+1, exp, a_typename(got));
}

// Field of a table (borrowed).
static AVal _pico_atmos_get (AVal t, const char* k) {
    AVal key = a_strz(k);
    AVal v = a_tab_get(A_TAB_OF(t), key);
    a_dec(key);
    return v;
}

// Sets a field of a table, consuming the value.
static void _pico_atmos_set (AVal t, const char* k, AVal v) {
    AVal key = a_strz(k);
    a_setindex(t, key, v);
    a_dec(key);
    a_dec(v);
}

static void _pico_atmos_set0 (AVal t, char mode) {
    AVal v = a_str(&mode, 1);
    a_setindex(t, a_int(0), v);
    a_dec(v);
}

static int _pico_atmos_tab (AVal v, const char* what) {
    if (v.type != A_TAB) {
        a_error("%s : expected %s table, got %s", _PICO_ATMOS_FN, what, a_typename(v));
        return 0;
    }
    return 1;
}

// Numeric field of a table. If absent: 0 if optional, else an error.
static int _pico_atmos_num (AVal t, const char* k, int req, float* out) {
    AVal v = _pico_atmos_get(t, k);
    if (v.type==A_NIL && !req) {
        *out = 0;
        return 1;
    }
    if (!a_isnum(v)) {
        a_error("%s : expected numeric field '%s'", _PICO_ATMOS_FN, k);
        return 0;
    }
    *out = (float) a_dbl(v);
    return 1;
}

static int _pico_atmos_int (AVal v, int i, int* out) {
    int64_t n;
    if (!a_toint(v, &n)) {
        _pico_atmos_bad(i, "integer", v);
        return 0;
    }
    *out = (int) n;
    return 1;
}

static int _pico_atmos_str (AVal v, int i, const char** out) {
    if (v.type != A_STR) {
        _pico_atmos_bad(i, "string", v);
        return 0;
    }
    *out = A_STR_OF(v)->s;
    return 1;
}

// A file that must exist, since pico aborts otherwise.
static int _pico_atmos_file (const char* path) {
    FILE* f = fopen(path, "rb");
    if (f == NULL) {
        a_error("%s : cannot open file \"%s\"", _PICO_ATMOS_FN, path);
        return 0;
    }
    fclose(f);
    return 1;
}

// A text as a string (owned): numbers are converted.
static int _pico_atmos_text (AVal v, int i, AVal* out) {
    if (v.type == A_STR) {
        a_inc(v);
        *out = v;
        return 1;
    }
    if (a_isnum(v)) {
        *out = a_tostring(v);
        return 1;
    }
    _pico_atmos_bad(i, "string", v);
    return 0;
}

// Mode string ('!', '%', '#'), or 0.
static char _pico_atmos_mode_s (AVal v) {
    if (v.type!=A_STR || A_STR_OF(v)->len!=1) {
        return '\0';
    }
    char c = A_STR_OF(v)->s[0];
    return (c=='!' || c=='%' || c=='#') ? c : '\0';
}

// Mode at index 0 of a table. If absent: '!' if optional.
static int _pico_atmos_mode_t (AVal t, int req, char* out) {
    AVal v = a_tab_get(A_TAB_OF(t), a_int(0));
    char mode = '!';
    if (v.type == A_STR) {
        mode = A_STR_OF(v)->s[0];
    } else if (v.type!=A_NIL || req) {
        a_error("%s : invalid mode at index 0", _PICO_ATMOS_FN);
        return 0;
    }
    if (mode!='!' && mode!='%' && mode!='#') {
        a_error("%s : invalid mode '%c': expected '!', '%%', or '#'",
            _PICO_ATMOS_FN, mode);
        return 0;
    }
    *out = mode;
    return 1;
}

static const struct { const char* name; const Pico_Color* clr; } _PICO_ATMOS_COLORS[] = {
    { "black",   &PICO_COLOR_BLACK   }, { "white",   &PICO_COLOR_WHITE   },
    { "gray",    &PICO_COLOR_GRAY    }, { "silver",  &PICO_COLOR_SILVER  },
    { "red",     &PICO_COLOR_RED     }, { "green",   &PICO_COLOR_GREEN   },
    { "blue",    &PICO_COLOR_BLUE    }, { "yellow",  &PICO_COLOR_YELLOW  },
    { "cyan",    &PICO_COLOR_CYAN    }, { "magenta", &PICO_COLOR_MAGENTA },
    { "orange",  &PICO_COLOR_ORANGE  }, { "purple",  &PICO_COLOR_PURPLE  },
    { "pink",    &PICO_COLOR_PINK    }, { "brown",   &PICO_COLOR_BROWN   },
    { "lime",    &PICO_COLOR_LIME    }, { "teal",    &PICO_COLOR_TEAL    },
    { "navy",    &PICO_COLOR_NAVY    }, { "maroon",  &PICO_COLOR_MAROON  },
    { "olive",   &PICO_COLOR_OLIVE   },
    { "transparent", &PICO_COLOR_TRANSPARENT },
};

// 'red' | 0xRRGGBB | ['!'|'%', r=, g=, b=, a=]
static int _pico_atmos_color (AVal v, Pico_Color* out) {
    if (v.type == A_STR) {
        for (size_t i=0; i<sizeof(_PICO_ATMOS_COLORS)/sizeof(_PICO_ATMOS_COLORS[0]); i++) {
            if (!strcmp(_PICO_ATMOS_COLORS[i].name, A_STR_OF(v)->s)) {
                *out = *_PICO_ATMOS_COLORS[i].clr;
                return 1;
            }
        }
        a_error("%s : invalid color \"%s\"", _PICO_ATMOS_FN, A_STR_OF(v)->s);
        return 0;
    }
    if (v.type == A_INT) {
        *out = pico_color_hex((uint32_t) v.u.i);
        return 1;
    }
    if (!_pico_atmos_tab(v, "color")) {
        return 0;
    }
    char mode;
    if (!_pico_atmos_mode_t(v, 0, &mode)) {
        return 0;
    }
    if (mode == '#') {
        a_error("%s : invalid mode '%c': expected '!', '%%'", _PICO_ATMOS_FN, mode);
        return 0;
    }
    float r, g, b;
    float a = (mode == '%') ? 1.0 : 0xFF;
    if (_pico_atmos_get(v,"a").type!=A_NIL && !_pico_atmos_num(v,"a",1,&a)) {
        return 0;
    }
    if (!_pico_atmos_num(v,"r",1,&r) || !_pico_atmos_num(v,"g",1,&g) || !_pico_atmos_num(v,"b",1,&b)) {
        return 0;
    }
    if (mode == '%') {
        *out = (Pico_Color) { r*255, g*255, b*255, a*255 };
    } else {
        *out = (Pico_Color) { r, g, b, a };
    }
    return 1;
}

static const struct { const char* name; const Pico_Anchor* anc; } _PICO_ATMOS_ANCHORS[] = {
    { "C",  &PICO_ANCHOR_C  }, { "NW", &PICO_ANCHOR_NW }, { "N",  &PICO_ANCHOR_N  },
    { "NE", &PICO_ANCHOR_NE }, { "E",  &PICO_ANCHOR_E  }, { "SE", &PICO_ANCHOR_SE },
    { "S",  &PICO_ANCHOR_S  }, { "SW", &PICO_ANCHOR_SW }, { "W",  &PICO_ANCHOR_W  },
};

// Field `anchor` of a table: 'NW' | [x=,y=], or 'C' if absent.
static int _pico_atmos_anchor (AVal t, Pico_Anchor* out) {
    AVal v = _pico_atmos_get(t, "anchor");
    if (v.type == A_NIL) {
        *out = PICO_ANCHOR_C;
        return 1;
    }
    if (v.type == A_STR) {
        for (size_t i=0; i<sizeof(_PICO_ATMOS_ANCHORS)/sizeof(_PICO_ATMOS_ANCHORS[0]); i++) {
            if (!strcmp(_PICO_ATMOS_ANCHORS[i].name, A_STR_OF(v)->s)) {
                *out = *_PICO_ATMOS_ANCHORS[i].anc;
                return 1;
            }
        }
        a_error("%s : invalid anchor \"%s\"", _PICO_ATMOS_FN, A_STR_OF(v)->s);
        return 0;
    }
    if (v.type == A_TAB) {
        return _pico_atmos_num(v,"x",1,&out->x) && _pico_atmos_num(v,"y",1,&out->y);
    }
    a_error("%s : invalid anchor", _PICO_ATMOS_FN);
    return 0;
}

static int _pico_atmos_rect (AVal v, Pico_Rel_Rect* r) {
    return _pico_atmos_tab(v, "rect")
        && _pico_atmos_mode_t(v, 1, &r->mode)
        && _pico_atmos_num(v, "x", 1, &r->x) && _pico_atmos_num(v, "y", 1, &r->y)
        && _pico_atmos_num(v, "w", 0, &r->w) && _pico_atmos_num(v, "h", 0, &r->h)
        && _pico_atmos_anchor(v, &r->anchor);
}

static int _pico_atmos_dim (AVal v, Pico_Rel_Dim* d) {
    return _pico_atmos_tab(v, "dim")
        && _pico_atmos_mode_t(v, 1, &d->mode)
        && _pico_atmos_num(v, "w", 0, &d->w) && _pico_atmos_num(v, "h", 0, &d->h);
}

static int _pico_atmos_pos (AVal v, Pico_Rel_Pos* p) {
    return _pico_atmos_tab(v, "pos")
        && _pico_atmos_mode_t(v, 1, &p->mode)
        && _pico_atmos_num(v, "x", 1, &p->x) && _pico_atmos_num(v, "y", 1, &p->y)
        && _pico_atmos_anchor(v, &p->anchor);
}

// Vector of positions (malloc'ed).
static int _pico_atmos_poss (AVal v, int* n, Pico_Rel_Pos** ps) {
    if (!_pico_atmos_tab(v, "positions")) {
        return 0;
    }
    *n  = A_TAB_OF(v)->an;
    *ps = malloc((*n + 1) * sizeof(Pico_Rel_Pos));
    for (int i=0; i<*n; i++) {
        AVal p = a_tab_get(A_TAB_OF(v), a_int(i));
        if (p.type != A_TAB) {
            a_error("%s : expected position at index %d", _PICO_ATMOS_FN, i);
        }
        if (p.type!=A_TAB || !_pico_atmos_pos(p, &(*ps)[i])) {
            free(*ps);
            return 0;
        }
    }
    return 1;
}

// Matrix of colors (malloc'ed).
static int _pico_atmos_pixmap (AVal v, Pico_Abs_Dim* dim, Pico_Color** buf) {
    if (v.type != A_TAB) {
        a_error("%s : required 'pixels' table", _PICO_ATMOS_FN);
        return 0;
    }
    AVal row0 = a_tab_get(A_TAB_OF(v), a_int(0));
    if (row0.type != A_TAB) {
        a_error("%s : expected row tables", _PICO_ATMOS_FN);
        return 0;
    }
    dim->h = A_TAB_OF(v)->an;
    dim->w = A_TAB_OF(row0)->an;
    if (dim->w == 0) {
        a_error("%s : expected row tables", _PICO_ATMOS_FN);
        return 0;
    }
    *buf = malloc(dim->w * dim->h * sizeof(Pico_Color));
    for (int y=0; y<dim->h; y++) {
        AVal row = a_tab_get(A_TAB_OF(v), a_int(y));
        if (row.type != A_TAB) {
            a_error("%s : expected table at row %d", _PICO_ATMOS_FN, y);
            free(*buf);
            return 0;
        }
        for (int x=0; x<dim->w; x++) {
            AVal c = a_tab_get(A_TAB_OF(row), a_int(x));
            if (!_pico_atmos_color(c, &(*buf)[y*dim->w + x])) {
                free(*buf);
                return 0;
            }
        }
    }
    return 1;
}

static int _pico_atmos_is_lay (AVal v) {
    return a_nat_is(v, _PICO_ATMOS_KIND_LAY);
}

// A layer box that is still valid.
static int _pico_atmos_lay (AVal v, _PICO_ATMOS_Lay** out) {
    if (!_pico_atmos_is_lay(v)) {
        a_error("%s : expected layer, got %s", _PICO_ATMOS_FN, a_typename(v));
        return 0;
    }
    _PICO_ATMOS_Lay* s = a_nat_ptr(v);
    if (s==NULL || s->gen!=_PICO_ATMOS.gen) {
        a_error("%s : invalid layer : it was released or pico was closed", _PICO_ATMOS_FN);
        return 0;
    }
    *out = s;
    return 1;
}

// A layer box or nil, as a layer or NULL (the current one).
static int _pico_atmos_lay_opt (AVal v, Pico_Layer** lay, _PICO_ATMOS_Lay** out) {
    _PICO_ATMOS_Lay* s = NULL;
    if (v.type!=A_NIL && !_pico_atmos_lay(v, &s)) {
        return 0;
    }
    *lay = (s == NULL) ? NULL : s->lay;
    if (out != NULL) {
        *out = s;
    }
    return 1;
}

// A font or sound box that is still valid.
static int _pico_atmos_res (AVal v, const char* kind, _PICO_ATMOS_Res** out) {
    const char* name = (kind == _PICO_ATMOS_KIND_FNT) ? "font" : "sound";
    if (!a_nat_is(v, kind)) {
        a_error("%s : expected %s, got %s", _PICO_ATMOS_FN, name, a_typename(v));
        return 0;
    }
    _PICO_ATMOS_Res* r = a_nat_ptr(v);
    if (r==NULL || r->gen!=_PICO_ATMOS.gen) {
        a_error("%s : invalid %s : it was released or pico was closed",
            _PICO_ATMOS_FN, name);
        return 0;
    }
    *out = r;
    return 1;
}

// Matches the arguments against the slots (L1, v1, L2, v2): a layer
// slot takes a layer, a value slot takes anything else, nil fills any
// slot, and a mismatch leaves the slot empty.
static void _pico_atmos_match4 (int argc, AVal* argv, AVal out[4]) {
    int i = 0;
    for (int s=0; s<4; s++) {
        AVal a = _PICO_ATMOS_ARG(i);
        if (a.type==A_NIL || _pico_atmos_is_lay(a)==(s%2 == 0)) {
            out[s] = a;
            i++;
        } else {
            out[s] = a_nil();
        }
    }
}

///////////////////////////////////////////////////////////////////////////////
// RESULTS (all owned)
///////////////////////////////////////////////////////////////////////////////

static AVal _pico_atmos_mk_anchor (Pico_Anchor a) {
    AVal t = a_tab();
    _pico_atmos_set(t, "x", a_num(a.x));
    _pico_atmos_set(t, "y", a_num(a.y));
    return t;
}

static AVal _pico_atmos_mk_color (Pico_Color c) {
    AVal t = a_tab();
    _pico_atmos_set(t, "r", a_int(c.r));
    _pico_atmos_set(t, "g", a_int(c.g));
    _pico_atmos_set(t, "b", a_int(c.b));
    _pico_atmos_set(t, "a", a_int(c.a));
    return t;
}

static AVal _pico_atmos_mk_rect (Pico_Rel_Rect r) {
    AVal t = a_tab();
    _pico_atmos_set0(t, r.mode);
    _pico_atmos_set(t, "x", a_num(r.x));
    _pico_atmos_set(t, "y", a_num(r.y));
    _pico_atmos_set(t, "w", a_num(r.w));
    _pico_atmos_set(t, "h", a_num(r.h));
    _pico_atmos_set(t, "anchor", _pico_atmos_mk_anchor(r.anchor));
    return t;
}

static AVal _pico_atmos_mk_pos (Pico_Rel_Pos p) {
    AVal t = a_tab();
    _pico_atmos_set0(t, p.mode);
    _pico_atmos_set(t, "x", a_num(p.x));
    _pico_atmos_set(t, "y", a_num(p.y));
    _pico_atmos_set(t, "anchor", _pico_atmos_mk_anchor(p.anchor));
    return t;
}

static AVal _pico_atmos_mk_dim (char mode, double w, double h) {
    AVal t = a_tab();
    _pico_atmos_set0(t, mode);
    _pico_atmos_set(t, "w", a_numi(w));
    _pico_atmos_set(t, "h", a_numi(h));
    return t;
}

static void _pico_atmos_fill_keyboard (AVal t, Pico_Keyboard k) {
    _pico_atmos_set(t, "key",   a_strz(SDL_GetKeyName(k.key)));
    _pico_atmos_set(t, "ctrl",  a_bool(k.ctrl));
    _pico_atmos_set(t, "shift", a_bool(k.shift));
    _pico_atmos_set(t, "alt",   a_bool(k.alt));
}

static void _pico_atmos_fill_mouse (AVal t, Pico_Mouse m) {
    _pico_atmos_set0(t, m.mode);
    _pico_atmos_set(t, "x", a_num(m.x));
    _pico_atmos_set(t, "y", a_num(m.y));
    _pico_atmos_set(t, "anchor", _pico_atmos_mk_anchor(m.anchor));
    _pico_atmos_set(t, "left",   a_bool(m.left));
    _pico_atmos_set(t, "right",  a_bool(m.right));
    _pico_atmos_set(t, "middle", a_bool(m.middle));
}

// The state of the mouse, as `pico_get_mouse`, except that the mouse of
// PICO_ATM_MOUSE replaces the real one while it is active.
static Pico_Mouse _pico_atmos_mouse (Pico_Layer* lay, Pico_Rel_Pos* pos) {
    if (!_PICO_ATMOS.mouse.on) {
        return pico_get_mouse(lay, pos);
    }
    Pico_Mouse m = {
        .mode   = pos->mode,
        .anchor = pos->anchor,
        .left   = _PICO_ATMOS.mouse.left,
    };
    Pico_Rel_Pos phy = { '!', {_PICO_ATMOS.mouse.x, _PICO_ATMOS.mouse.y}, PICO_ANCHOR_NW };
    pico_cv_pos(lay, pos, pico_layer_window(), &phy);
    m.x = pos->x;
    m.y = pos->y;
    return m;
}

static const struct { const char* name; int id; } _PICO_ATMOS_EVENTS[] = {
    { "quit",            PICO_EVENT_QUIT            },
    { "window.resize",   PICO_EVENT_WINDOW_RESIZE   },
    { "key.dn",          PICO_EVENT_KEY_DN          },
    { "key.up",          PICO_EVENT_KEY_UP          },
    { "mouse.motion",    PICO_EVENT_MOUSE_MOTION    },
    { "mouse.button.dn", PICO_EVENT_MOUSE_BUTTON_DN },
    { "mouse.button.up", PICO_EVENT_MOUSE_BUTTON_UP },
};
#define _PICO_ATMOS_NEVENTS ((int)(sizeof(_PICO_ATMOS_EVENTS)/sizeof(_PICO_ATMOS_EVENTS[0])))

// An event as a tagged table: `:key.dn [key='A', ...]`.
static AVal _pico_atmos_mk_event (Pico_Event* e) {
    AVal t = a_tab();
    for (int i=0; i<_PICO_ATMOS_NEVENTS; i++) {
        if (_PICO_ATMOS_EVENTS[i].id == (int)e->type) {
            AVal tag = a_strz(_PICO_ATMOS_EVENTS[i].name);
            a_tag(t, tag);
            a_dec(tag);
        }
    }
    switch (e->type) {
        case PICO_EVENT_KEY_DN:
        case PICO_EVENT_KEY_UP:
            _pico_atmos_fill_keyboard(t, e->keyboard);
            break;
        case PICO_EVENT_MOUSE_MOTION:
        case PICO_EVENT_MOUSE_BUTTON_DN:
        case PICO_EVENT_MOUSE_BUTTON_UP:
            _pico_atmos_fill_mouse(t, e->mouse);
            break;
        case PICO_EVENT_WINDOW_RESIZE:
            _pico_atmos_set(t, "w", a_int(e->window.w));
            _pico_atmos_set(t, "h", a_int(e->window.h));
            break;
        default:
            break;
    }
    return t;
}

static const char* _PICO_ATMOS_STYLES[] = { "fill", "stroke" };
static const char* _PICO_ATMOS_FLIPS[]  = { "none", "horizontal", "vertical", "both" };

// Index of a name in a list, or an error.
static int _pico_atmos_enum (AVal v, const char* what, const char** names, int n, int* out) {
    if (v.type == A_STR) {
        for (int i=0; i<n; i++) {
            if (!strcmp(names[i], A_STR_OF(v)->s)) {
                *out = i;
                return 1;
            }
        }
        a_error("%s : invalid %s \"%s\"", _PICO_ATMOS_FN, what, A_STR_OF(v)->s);
    } else {
        a_error("%s : invalid %s", _PICO_ATMOS_FN, what);
    }
    return 0;
}

///////////////////////////////////////////////////////////////////////////////
// OPEN / CLOSE
///////////////////////////////////////////////////////////////////////////////

// Opens pico and creates what the binding holds: `main` at the start of the
// program (the default window), and `pico.open` after a `pico.close`.
static void _pico_atmos_open (Pico_Window* win) {
    pico_open(win);
    _PICO_ATMOS.open = 1;
    _PICO_ATMOS.mouse.on = 0;
    _PICO_ATMOS.gen++;
    a_set(&_PICO_ATMOS.world,  _pico_atmos_lay_new(pico_layer_world(),  _PICO_ATMOS_ROOT, NULL, NULL));
    a_set(&_PICO_ATMOS.window, _pico_atmos_lay_new(pico_layer_window(), _PICO_ATMOS_ROOT, NULL, NULL));
    _pico_atmos_cur(_PICO_ATMOS.world);
}

// pico.open([title=, fs=|fullscreen=, show=]): only after a `pico.close`
static AStatus _pico_atmos_l_open (AFunc* self, int argc, AVal* argv) {
    _PICO_ATMOS_IN0("open")
    if (_PICO_ATMOS.open) {
        return a_error("%s : pico is already open", _PICO_ATMOS_FN);
    }
    Pico_Window win = { .fs=0, .show=1, .title=NULL };
    AVal t = _PICO_ATMOS_ARG(0);
    if (t.type != A_NIL) {
        _PICO_ATMOS_TRY(_pico_atmos_tab(t, "window"));
        AVal fs = _pico_atmos_get(t, "fs");
        if (fs.type == A_NIL) {
            fs = _pico_atmos_get(t, "fullscreen");
        }
        AVal show  = _pico_atmos_get(t, "show");
        AVal title = _pico_atmos_get(t, "title");
        win.fs = a_truthy(fs);
        if (show.type != A_NIL) {
            win.show = a_truthy(show);
        }
        if (title.type != A_NIL) {
            _PICO_ATMOS_TRY(_pico_atmos_str(title, 0, &win.title));
        }
    }
    _pico_atmos_open(&win);
    return A_OK;
}

// pico.close()
static AStatus _pico_atmos_l_close (AFunc* self, int argc, AVal* argv) {
    _PICO_ATMOS_IN("close")
    _pico_atmos_close();
    return A_OK;
}

// pico.quit()
static AStatus _pico_atmos_l_quit (AFunc* self, int argc, AVal* argv) {
    _PICO_ATMOS_IN("quit")
    pico_quit();
    return A_OK;
}

///////////////////////////////////////////////////////////////////////////////
// CV / IN / VS
///////////////////////////////////////////////////////////////////////////////

// pico.cv.dim([L_to,] to|mode, [L_fr,] fr)
static AStatus _pico_atmos_l_cv_dim (AFunc* self, int argc, AVal* argv) {
    _PICO_ATMOS_IN("cv.dim")
    AVal a[4];
    _pico_atmos_match4(argc, argv, a);
    Pico_Layer *L_to, *L_fr;
    Pico_Rel_Dim to = {0}, fr;
    _PICO_ATMOS_TRY(_pico_atmos_lay_opt(a[0],&L_to,NULL) && _pico_atmos_lay_opt(a[2],&L_fr,NULL));
    _PICO_ATMOS_TRY(_pico_atmos_dim(a[3], &fr));
    char m = _pico_atmos_mode_s(a[1]);
    if (m != '\0') {
        to.mode = m;
    } else {
        _PICO_ATMOS_TRY(_pico_atmos_tab(a[1],"dim") && _pico_atmos_mode_t(a[1],1,&to.mode));
    }
    pico_cv_dim(L_to, &to, L_fr, &fr);
    if (m != '\0') {
        AVal t = a_tab();
        _pico_atmos_set0(t, to.mode);
        _pico_atmos_set(t, "w", a_num(to.w));
        _pico_atmos_set(t, "h", a_num(to.h));
        a_push(t);
    } else {
        _pico_atmos_set(a[1], "w", a_num(to.w));
        _pico_atmos_set(a[1], "h", a_num(to.h));
        a_pushc(a[1]);
    }
    return A_OK;
}

// pico.cv.pos([L_to,] to|mode, [L_fr,] fr)
static AStatus _pico_atmos_l_cv_pos (AFunc* self, int argc, AVal* argv) {
    _PICO_ATMOS_IN("cv.pos")
    AVal a[4];
    _pico_atmos_match4(argc, argv, a);
    Pico_Layer *L_to, *L_fr;
    Pico_Rel_Pos to = { .anchor=PICO_ANCHOR_C }, fr;
    _PICO_ATMOS_TRY(_pico_atmos_lay_opt(a[0],&L_to,NULL) && _pico_atmos_lay_opt(a[2],&L_fr,NULL));
    _PICO_ATMOS_TRY(_pico_atmos_pos(a[3], &fr));
    char m = _pico_atmos_mode_s(a[1]);
    if (m != '\0') {
        to.mode = m;
    } else {
        _PICO_ATMOS_TRY(_pico_atmos_tab(a[1],"pos") && _pico_atmos_mode_t(a[1],1,&to.mode)
            && _pico_atmos_anchor(a[1],&to.anchor));
    }
    pico_cv_pos(L_to, &to, L_fr, &fr);
    if (m != '\0') {
        a_push(_pico_atmos_mk_pos(to));
    } else {
        _pico_atmos_set(a[1], "x", a_num(to.x));
        _pico_atmos_set(a[1], "y", a_num(to.y));
        a_pushc(a[1]);
    }
    return A_OK;
}

// pico.cv.rect([L_to,] to|mode, [L_fr,] fr)
static AStatus _pico_atmos_l_cv_rect (AFunc* self, int argc, AVal* argv) {
    _PICO_ATMOS_IN("cv.rect")
    AVal a[4];
    _pico_atmos_match4(argc, argv, a);
    Pico_Layer *L_to, *L_fr;
    Pico_Rel_Rect to = { .anchor=PICO_ANCHOR_C }, fr;
    _PICO_ATMOS_TRY(_pico_atmos_lay_opt(a[0],&L_to,NULL) && _pico_atmos_lay_opt(a[2],&L_fr,NULL));
    _PICO_ATMOS_TRY(_pico_atmos_rect(a[3], &fr));
    char m = _pico_atmos_mode_s(a[1]);
    if (m != '\0') {
        to.mode = m;
    } else {
        _PICO_ATMOS_TRY(_pico_atmos_tab(a[1],"rect") && _pico_atmos_mode_t(a[1],1,&to.mode)
            && _pico_atmos_anchor(a[1],&to.anchor));
    }
    pico_cv_rect(L_to, &to, L_fr, &fr);
    if (m != '\0') {
        a_push(_pico_atmos_mk_rect(to));
    } else {
        _pico_atmos_set(a[1], "x", a_num(to.x));
        _pico_atmos_set(a[1], "y", a_num(to.y));
        _pico_atmos_set(a[1], "w", a_num(to.w));
        _pico_atmos_set(a[1], "h", a_num(to.h));
        a_pushc(a[1]);
    }
    return A_OK;
}

// pico.in.rect(out, in)
static AStatus _pico_atmos_l_in_rect (AFunc* self, int argc, AVal* argv) {
    _PICO_ATMOS_IN("in.rect")
    Pico_Rel_Rect out, in;
    _PICO_ATMOS_TRY(_pico_atmos_rect(_PICO_ATMOS_ARG(0),&out) && _pico_atmos_rect(_PICO_ATMOS_ARG(1),&in));
    a_push(_pico_atmos_mk_rect(pico_in_rect(out, in)));
    return A_OK;
}

// pico.in.pos(out, in)
static AStatus _pico_atmos_l_in_pos (AFunc* self, int argc, AVal* argv) {
    _PICO_ATMOS_IN("in.pos")
    Pico_Rel_Rect out;
    Pico_Rel_Pos  in;
    _PICO_ATMOS_TRY(_pico_atmos_rect(_PICO_ATMOS_ARG(0),&out) && _pico_atmos_pos(_PICO_ATMOS_ARG(1),&in));
    a_push(_pico_atmos_mk_pos(pico_in_pos(out, in)));
    return A_OK;
}

// pico.in.dim(out, in)
static AStatus _pico_atmos_l_in_dim (AFunc* self, int argc, AVal* argv) {
    _PICO_ATMOS_IN("in.dim")
    Pico_Rel_Rect out;
    Pico_Rel_Dim  in;
    _PICO_ATMOS_TRY(_pico_atmos_rect(_PICO_ATMOS_ARG(0),&out) && _pico_atmos_dim(_PICO_ATMOS_ARG(1),&in));
    Pico_Rel_Dim ret = pico_in_dim(out, in);
    AVal t = a_tab();
    _pico_atmos_set0(t, ret.mode);
    _pico_atmos_set(t, "w", a_num(ret.w));
    _pico_atmos_set(t, "h", a_num(ret.h));
    a_push(t);
    return A_OK;
}

// pico.vs.pos.pos([L1,] p1, [L2,] p2)
static AStatus _pico_atmos_l_vs_pos_pos (AFunc* self, int argc, AVal* argv) {
    _PICO_ATMOS_IN("vs.pos.pos")
    AVal a[4];
    _pico_atmos_match4(argc, argv, a);
    Pico_Layer *L1, *L2;
    Pico_Rel_Pos p1, p2;
    _PICO_ATMOS_TRY(_pico_atmos_lay_opt(a[0],&L1,NULL) && _pico_atmos_lay_opt(a[2],&L2,NULL));
    _PICO_ATMOS_TRY(_pico_atmos_pos(a[1],&p1) && _pico_atmos_pos(a[3],&p2));
    a_push(a_bool(pico_vs_pos_pos(L1, &p1, L2, &p2)));
    return A_OK;
}

// pico.vs.pos.rect([L1,] p1, [L2,] [r2])
static AStatus _pico_atmos_l_vs_pos_rect (AFunc* self, int argc, AVal* argv) {
    _PICO_ATMOS_IN("vs.pos.rect")
    AVal a[4];
    _pico_atmos_match4(argc, argv, a);
    Pico_Layer *L1, *L2;
    Pico_Rel_Pos p1;
    Pico_Rel_Rect r2, *xr2=NULL;
    _PICO_ATMOS_TRY(_pico_atmos_lay_opt(a[0],&L1,NULL) && _pico_atmos_lay_opt(a[2],&L2,NULL));
    _PICO_ATMOS_TRY(_pico_atmos_pos(a[1], &p1));
    if (a[3].type != A_NIL) {
        _PICO_ATMOS_TRY(_pico_atmos_rect(a[3], &r2));
        xr2 = &r2;
    }
    a_push(a_bool(pico_vs_pos_rect(L1, &p1, L2, xr2)));
    return A_OK;
}

// pico.vs.rect.pos([L1,] [r1,] [L2,] p2)
static AStatus _pico_atmos_l_vs_rect_pos (AFunc* self, int argc, AVal* argv) {
    _PICO_ATMOS_IN("vs.rect.pos")
    AVal a[4];
    _pico_atmos_match4(argc, argv, a);
    if (a[3].type==A_NIL && a[1].type!=A_NIL) {
        a[3] = a[1];                    // (L1, p2) and (p2): no r1
        a[1] = a_nil();
    }
    Pico_Layer *L1, *L2;
    Pico_Rel_Rect r1, *xr1=NULL;
    Pico_Rel_Pos p2;
    _PICO_ATMOS_TRY(_pico_atmos_lay_opt(a[0],&L1,NULL) && _pico_atmos_lay_opt(a[2],&L2,NULL));
    if (a[1].type != A_NIL) {
        _PICO_ATMOS_TRY(_pico_atmos_rect(a[1], &r1));
        xr1 = &r1;
    }
    _PICO_ATMOS_TRY(_pico_atmos_pos(a[3], &p2));
    a_push(a_bool(pico_vs_rect_pos(L1, xr1, L2, &p2)));
    return A_OK;
}

// pico.vs.rect.rect([L1,] [r1,] [L2,] [r2])
static AStatus _pico_atmos_l_vs_rect_rect (AFunc* self, int argc, AVal* argv) {
    _PICO_ATMOS_IN("vs.rect.rect")
    AVal a[4];
    _pico_atmos_match4(argc, argv, a);
    Pico_Layer *L1, *L2;
    Pico_Rel_Rect r1, *xr1=NULL;
    Pico_Rel_Rect r2, *xr2=NULL;
    _PICO_ATMOS_TRY(_pico_atmos_lay_opt(a[0],&L1,NULL) && _pico_atmos_lay_opt(a[2],&L2,NULL));
    if (a[1].type != A_NIL) {
        _PICO_ATMOS_TRY(_pico_atmos_rect(a[1], &r1));
        xr1 = &r1;
    }
    if (a[3].type != A_NIL) {
        _PICO_ATMOS_TRY(_pico_atmos_rect(a[3], &r2));
        xr2 = &r2;
    }
    a_push(a_bool(pico_vs_rect_rect(L1, xr1, L2, xr2)));
    return A_OK;
}

