include "../pico.atm"

pico.open()
pico.set.window [ title="pixels" ]
pico.set.layer(pico.layer.window())
pico.set.scene [ dim=['!', w=100, h=100] ]
pico.set.layer(pico.layer.world())
pico.set.scene [ dim=['!', w=5, h=5] ]

do {
    val pixels = [
        ['!', x=1, y=1, anchor='NW'], ['!', x=2, y=1, anchor='NW'], ['!', x=3, y=1, anchor='NW'],
        ['!', x=1, y=2, anchor='NW'], ['!', x=2, y=2, anchor='NW'], ['!', x=3, y=2, anchor='NW'],
        ['!', x=1, y=3, anchor='NW'], ['!', x=2, y=3, anchor='NW'], ['!', x=3, y=3, anchor='NW']
    ]
    loop i in (1,9) {
        pico.output.clear()
        ;; the first `i` pixels
        val ps = []
        loop j in i {
            set ps@+ = pixels@j
        }
        pico.output.draw.pixels(ps)
        print(i ++ " pixels")
        pico.input.delay(10)
    }
    pico.check("pixels-01")
}

do {
    val pixels = [
        ['%', x=0, y=0, anchor='NW'],
        ['%', x=1, y=0, anchor='NE'],
        ['%', x=0, y=1, anchor='SW'],
        ['%', x=1, y=1, anchor='SE'],
    ]
    pico.output.draw.pixels(pixels)
    pico.check("pixels-02")
}

pico.close()
