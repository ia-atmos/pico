}

// pico.get.effect()
static AStatus _pico_atmos_l_get_effect (AFunc* self, int argc, AVal* argv) {
    _PICO_ATMOS_IN("get.effect")
    Pico_Layer_Effect e = pico_get_effect();
    AVal t = a_tab();
    _pico_atmos_set(t, "alpha", a_int(e.alpha));
    _pico_atmos_set(t, "color", _pico_atmos_mk_color(e.color));
    _pico_atmos_set(t, "flip",  a_strz(_PICO_ATMOS_FLIPS[e.flip & 3]));
    _pico_atmos_set(t, "grid",  a_bool(e.grid));
    AVal rot = a_tab();
    _pico_atmos_set(rot, "angle",  a_int(e.rotate.angle));
    _pico_atmos_set(rot, "anchor", _pico_atmos_mk_anchor(e.rotate.anchor));
    _pico_atmos_set(t, "rotate", rot);
    a_push(t);
    return A_OK;
}

// pico.get.expert(): on, fps
static AStatus _pico_atmos_l_get_expert (AFunc* self, int argc, AVal* argv) {
    _PICO_ATMOS_IN("get.expert")
    int fps;
    int on = pico_get_expert(&fps);
    a_push(a_bool(on));
    a_push(a_int(fps));
    return A_OK;
}

// A fresh `[mode, w=0, h=0]` (or with x=0, y=0) for a mode string or
// nil, or the table itself (all owned).
static int _pico_atmos_dim_or_mode (AVal v, int rect, AVal* out) {
    if (v.type == A_TAB) {
        a_inc(v);
        *out = v;
        return 1;
    }
    char mode = '!';
    if (v.type != A_NIL) {
        mode = _pico_atmos_mode_s(v);
        if (mode == '\0') {
            if (v.type == A_STR) {
                a_error("%s : invalid mode '%s': expected '!', '%%', or '#'",
                    _PICO_ATMOS_FN, A_STR_OF(v)->s);
            } else {
                _pico_atmos_bad(0, "table", v);
            }
            return 0;
        }
    }
    AVal t = a_tab();
    _pico_atmos_set0(t, mode);
    if (rect) {
        _pico_atmos_set(t, "x", a_int(0));
        _pico_atmos_set(t, "y", a_int(0));
    }
    _pico_atmos_set(t, "w", a_int(0));
    _pico_atmos_set(t, "h", a_int(0));
    *out = t;
    return 1;
}

// pico.get.image([dim|mode,] path)
static AStatus _pico_atmos_l_get_image (AFunc* self, int argc, AVal* argv) {
    _PICO_ATMOS_IN("get.image")
    AVal a0 = (argc <= 1) ? a_nil() : argv[0];
    AVal a1 = (argc <= 1) ? _PICO_ATMOS_ARG(0) : argv[1];
    const char* path;
    _PICO_ATMOS_TRY(_pico_atmos_str(a1,1,&path) && _pico_atmos_file(path));
    AVal t;
    _PICO_ATMOS_TRY(_pico_atmos_dim_or_mode(a0, 0, &t));
    Pico_Rel_Dim dim;
    if (!_pico_atmos_dim(t, &dim)) {
        a_dec(t);
        return A_ERROR;
    }
    pico_get_image(&dim, path);
    _pico_atmos_set(t, "w", a_num(dim.w));
    _pico_atmos_set(t, "h", a_num(dim.h));
    a_push(t);
    return A_OK;
}

// pico.get.keyboard()
static AStatus _pico_atmos_l_get_keyboard (AFunc* self, int argc, AVal* argv) {
    _PICO_ATMOS_IN("get.keyboard")
    AVal t = a_tab();
    _pico_atmos_fill_keyboard(t, pico_get_keyboard());
    a_push(t);
    return A_OK;
}

// The box of the current layer (owned), or nil if it is gone.
static AVal _pico_atmos_cur_box (void) {
    if (_pico_atmos_is_lay(_PICO_ATMOS.cur_box) && a_nat_ptr(_PICO_ATMOS.cur_box)!=NULL) {
        a_inc(_PICO_ATMOS.cur_box);
        return _PICO_ATMOS.cur_box;
    }
    return a_nil();
}

// pico.get.layer()
static AStatus _pico_atmos_l_get_layer (AFunc* self, int argc, AVal* argv) {
    _PICO_ATMOS_IN("get.layer")
    a_push(_pico_atmos_cur_box());
    return A_OK;
}

// pico.get.mouse([layer,] mode|pos)
static AStatus _pico_atmos_l_get_mouse (AFunc* self, int argc, AVal* argv) {
    _PICO_ATMOS_IN("get.mouse")
    AVal a[4];
    _pico_atmos_match4(argc, argv, a);
    Pico_Layer* lay;
    _PICO_ATMOS_TRY(_pico_atmos_lay_opt(a[0], &lay, NULL));
    Pico_Rel_Pos pos = { .anchor=PICO_ANCHOR_C };
    char m = _pico_atmos_mode_s(a[1]);
    if (m != '\0') {
        pos.mode = m;
    } else {
        _PICO_ATMOS_TRY(_pico_atmos_tab(a[1],"pos") && _pico_atmos_mode_t(a[1],1,&pos.mode)
            && _pico_atmos_anchor(a[1],&pos.anchor));
    }
    AVal t = a_tab();
    _pico_atmos_fill_mouse(t, _pico_atmos_mouse(lay, &pos));
    a_push(t);
    return A_OK;
}

// pico.get.now()
static AStatus _pico_atmos_l_get_now (AFunc* self, int argc, AVal* argv) {
    _PICO_ATMOS_IN("get.now")
    a_push(a_int(pico_get_now()));
    return A_OK;
}

// pico.get.pencil()
static AStatus _pico_atmos_l_get_pencil (AFunc* self, int argc, AVal* argv) {
    _PICO_ATMOS_IN("get.pencil")
    AVal t = a_tab();
    _pico_atmos_set(t, "color", _pico_atmos_mk_color(pico_get_pencil_color()));
    AVal font = _PICO_ATMOS.cur->font;       // nil if it is a font that is gone
    if (font.type!=A_NAT || a_nat_ptr(font)!=NULL) {
        a_inc(font);
        _pico_atmos_set(t, "font", font);
    }
    _pico_atmos_set(t, "style", a_strz(_PICO_ATMOS_STYLES[pico_get_pencil_style() & 1]));
    a_push(t);
    return A_OK;
}

// pico.get.scene()
static AStatus _pico_atmos_l_get_scene (AFunc* self, int argc, AVal* argv) {
    _PICO_ATMOS_IN("get.scene")
    Pico_Layer_Scene s;
    pico_get_scene(&s);
    AVal t = a_tab();
    _pico_atmos_set(t, "dim",    _pico_atmos_mk_dim('!', s.dim.w,  s.dim.h));
    _pico_atmos_set(t, "tile",   _pico_atmos_mk_dim('!', s.tile.w, s.tile.h));
    _pico_atmos_set(t, "target", _pico_atmos_mk_rect(s.dst));
    _pico_atmos_set(t, "source", _pico_atmos_mk_rect(s.src));
    _pico_atmos_set(t, "clip",   _pico_atmos_mk_rect(s.clip));
    _pico_atmos_set(t, "clear",  a_bool(s.clear));
    a_push(t);
    return A_OK;
}

// pico.get.text(dim, text)
static AStatus _pico_atmos_l_get_text (AFunc* self, int argc, AVal* argv) {
    _PICO_ATMOS_IN("get.text")
    Pico_Rel_Dim dim;
    AVal text;
    _PICO_ATMOS_TRY(_pico_atmos_dim(_PICO_ATMOS_ARG(0), &dim));
    if (dim.h == 0) {
        return a_error("%s : expected numeric field 'h'", _PICO_ATMOS_FN);
    }
    _PICO_ATMOS_TRY(_pico_atmos_text(_PICO_ATMOS_ARG(1), 1, &text));
    pico_get_text(&dim, A_STR_OF(text)->s);
    a_dec(text);
    _pico_atmos_set(argv[0], "w", a_num(dim.w));
    _pico_atmos_set(argv[0], "h", a_num(dim.h));
    a_pushc(argv[0]);
    return A_OK;
}

// pico.get.video([rect|mode,] layer|path)
static AStatus _pico_atmos_l_get_video (AFunc* self, int argc, AVal* argv) {
    _PICO_ATMOS_IN("get.video")
    AVal a0 = (argc <= 1) ? a_nil() : argv[0];
    AVal a1 = (argc <= 1) ? _PICO_ATMOS_ARG(0) : argv[1];
    if (_pico_atmos_is_lay(a0)) {                // (layer, rect|mode) is also fine
        AVal x = a0;
        a0 = a1;
        a1 = x;
    }
    const char* path = NULL;
    _PICO_ATMOS_Lay* s = NULL;
    if (_pico_atmos_is_lay(a1)) {
        _PICO_ATMOS_TRY(_pico_atmos_lay(a1, &s));
        if (s->kind != _PICO_ATMOS_VIDEO) {
            return a_error("%s : not a video layer", _PICO_ATMOS_FN);
        }
    } else {
        _PICO_ATMOS_TRY(_pico_atmos_str(a1,1,&path) && _pico_atmos_file(path));
    }
    AVal t;
    _PICO_ATMOS_TRY(_pico_atmos_dim_or_mode(a0, 1, &t));
    Pico_Rel_Rect rect;
    if (!_pico_atmos_rect(t, &rect)) {
        a_dec(t);
        return A_ERROR;
    }
    Pico_Video vid = (s != NULL) ? pico_get_video(&rect, s->lay)
                                 : pico_get_video_path(&rect, path);
    _pico_atmos_set(t, "w", a_num(rect.w));
    _pico_atmos_set(t, "h", a_num(rect.h));
    AVal ret = a_tab();
    _pico_atmos_set(ret, "dim",   t);
    _pico_atmos_set(ret, "fps",   a_int(vid.fps));
    _pico_atmos_set(ret, "frame", a_int(vid.frame));
    _pico_atmos_set(ret, "done",  a_bool(vid.done));
    a_push(ret);
    return A_OK;
}

// pico.get.window()
static AStatus _pico_atmos_l_get_window (AFunc* self, int argc, AVal* argv) {
    _PICO_ATMOS_IN("get.window")
    Pico_Window win = pico_get_window();
    AVal t = a_tab();
    _pico_atmos_set(t, "fullscreen", a_bool(win.fs));
    _pico_atmos_set(t, "show",       a_bool(win.show));
    _pico_atmos_set(t, "title",      a_strn(win.title));
    a_push(t);
    return A_OK;
}

///////////////////////////////////////////////////////////////////////////////
// SET
///////////////////////////////////////////////////////////////////////////////

// pico.set.aids(on)
static AStatus _pico_atmos_l_set_aids (AFunc* self, int argc, AVal* argv) {
    _PICO_ATMOS_IN("set.aids")
    if (_PICO_ATMOS_ARG(0).type != A_BOOL) {
        return _pico_atmos_bad(0, "boolean", _PICO_ATMOS_ARG(0));
    }
    pico_set_aids(a_truthy(argv[0]));
    return A_OK;
}

// A layer whose texture may be replaced: sub-layers borrow it.
static int _pico_atmos_resize (_PICO_ATMOS_Lay* s) {
    if (s->subs > 0) {
        a_error("%s : cannot resize a layer with live sub-layers", _PICO_ATMOS_FN);
        return 0;
    }
    return 1;
}

// pico.set.dim(dim)
static AStatus _pico_atmos_l_set_dim (AFunc* self, int argc, AVal* argv) {
    _PICO_ATMOS_IN("set.dim")
    Pico_Rel_Dim dim;
    _PICO_ATMOS_TRY(_pico_atmos_dim(_PICO_ATMOS_ARG(0), &dim));
    if (dim.mode == '%') {
        return a_error("%s : invalid mode '%%'", _PICO_ATMOS_FN);
    }
    _PICO_ATMOS_TRY(_pico_atmos_resize((_PICO_ATMOS_Lay*)a_nat_ptr(_PICO_ATMOS.world))
        && _pico_atmos_resize((_PICO_ATMOS_Lay*)a_nat_ptr(_PICO_ATMOS.window)));
    pico_set_dim(dim);
    return A_OK;
}

// pico.set.effect [alpha=, color=, flip=, grid=, rotate=[angle=,anchor=]]
static AStatus _pico_atmos_l_set_effect (AFunc* self, int argc, AVal* argv) {
    _PICO_ATMOS_IN("set.effect")
    AVal t = _PICO_ATMOS_ARG(0);
    _PICO_ATMOS_TRY(_pico_atmos_tab(t, "effect"));
    AVal alpha = _pico_atmos_get(t, "alpha");
    AVal color = _pico_atmos_get(t, "color");
    AVal flip  = _pico_atmos_get(t, "flip");
    AVal grid  = _pico_atmos_get(t, "grid");
    AVal rot   = _pico_atmos_get(t, "rotate");

    int xalpha, xflip;
    Pico_Color xcolor;
    Pico_Rot xrot;
    if (alpha.type != A_NIL) {
        int64_t n;
        if (!a_toint(alpha, &n)) {
            return a_error("%s : expected integer field 'alpha'", _PICO_ATMOS_FN);
        }
        xalpha = (int) n;
    }
    if (color.type != A_NIL) {
        _PICO_ATMOS_TRY(_pico_atmos_color(color, &xcolor));
    }
    if (flip.type != A_NIL) {
        _PICO_ATMOS_TRY(_pico_atmos_enum(flip, "flip", _PICO_ATMOS_FLIPS, 4, &xflip));
    }
    if (rot.type != A_NIL) {
        float angle;
        _PICO_ATMOS_TRY(_pico_atmos_tab(rot,"rotate") && _pico_atmos_num(rot,"angle",1,&angle)
            && _pico_atmos_anchor(rot,&xrot.anchor));
        xrot.angle = (int) angle;
    }

    if (alpha.type != A_NIL) { pico_set_effect_alpha((unsigned char)xalpha); }
    if (color.type != A_NIL) { pico_set_effect_color(xcolor);                }
    if (flip.type  != A_NIL) { pico_set_effect_flip((PICO_FLIP)xflip);       }
    if (grid.type  != A_NIL) { pico_set_effect_grid(a_truthy(grid));         }
    if (rot.type   != A_NIL) { pico_set_effect_rotate(xrot);                 }
    return A_OK;
}

// pico.set.expert(on [, fps])
static AStatus _pico_atmos_l_set_expert (AFunc* self, int argc, AVal* argv) {
    _PICO_ATMOS_IN("set.expert")
    if (_PICO_ATMOS_ARG(0).type != A_BOOL) {
        return _pico_atmos_bad(0, "boolean", _PICO_ATMOS_ARG(0));
    }
    int fps = 0;
    if (argc >= 2) {
        if (argv[1].type == A_BOOL) {
            fps = a_truthy(argv[1]) ? -1 : 0;
        } else {
            _PICO_ATMOS_TRY(_pico_atmos_int(argv[1], 1, &fps));
            if (fps < -1) {
                return a_error("%s : invalid fps", _PICO_ATMOS_FN);
            }
        }
    }
    a_push(a_int(pico_set_expert(a_truthy(argv[0]), fps)));
    return A_OK;
}

// pico.set.layer(layer): the previous one
static AStatus _pico_atmos_l_set_layer (AFunc* self, int argc, AVal* argv) {
    _PICO_ATMOS_IN("set.layer")
    _PICO_ATMOS_Lay* s;
    _PICO_ATMOS_TRY(_pico_atmos_lay(_PICO_ATMOS_ARG(0), &s));
    AVal old = _pico_atmos_cur_box();
    pico_set_layer(s->lay);
    _pico_atmos_cur(argv[0]);
    a_push(old);
    return A_OK;
}

// pico.set.mouse([layer,] pos)
static AStatus _pico_atmos_l_set_mouse (AFunc* self, int argc, AVal* argv) {
    _PICO_ATMOS_IN("set.mouse")
    AVal a[4];
    _pico_atmos_match4(argc, argv, a);
    Pico_Layer* lay;
    Pico_Rel_Pos pos;
    _PICO_ATMOS_TRY(_pico_atmos_lay_opt(a[0],&lay,NULL) && _pico_atmos_pos(a[1],&pos));
    pico_set_mouse(lay, pos);
    _PICO_ATMOS.mouse.on = 0;
    return A_OK;
}

// pico.set.pencil [color=, font=, style=]
static AStatus _pico_atmos_l_set_pencil (AFunc* self, int argc, AVal* argv) {
    _PICO_ATMOS_IN("set.pencil")
    AVal t = _PICO_ATMOS_ARG(0);
    _PICO_ATMOS_TRY(_pico_atmos_tab(t, "pencil"));
    AVal color = _pico_atmos_get(t, "color");
    AVal font  = _pico_atmos_get(t, "font");
    AVal style = _pico_atmos_get(t, "style");

    Pico_Color xcolor;
    int xstyle;
    _PICO_ATMOS_Res* xfont = NULL;
    if (color.type != A_NIL) {
        _PICO_ATMOS_TRY(_pico_atmos_color(color, &xcolor));
    }
    int dfont = (font.type==A_BOOL && a_truthy(font));
    if (dfont) {
        // true, the built-in font
    } else if (font.type == A_STR) {
        _PICO_ATMOS_TRY(_pico_atmos_file(A_STR_OF(font)->s));
    } else if (font.type == A_NAT) {
        _PICO_ATMOS_TRY(_pico_atmos_res(font, _PICO_ATMOS_KIND_FNT, &xfont));
    } else if (font.type != A_NIL) {
        return a_error("%s : invalid font : expected font, path, or true",
            _PICO_ATMOS_FN);
    }
    if (style.type != A_NIL) {
        _PICO_ATMOS_TRY(_pico_atmos_enum(style, "style", _PICO_ATMOS_STYLES, 2, &xstyle));
    }

    if (color.type != A_NIL) {
        pico_set_pencil_color(xcolor);
    }
    if (font.type != A_NIL) {
        if (font.type==A_STR && !dfont) {
            pico_set_pencil_font_path(A_STR_OF(font)->s);
        } else {
            pico_set_pencil_font((xfont == NULL) ? NULL : xfont->ptr);
        }
        if (xfont != NULL) {
            xfont->rc++;
        }
        _pico_atmos_res_unref(_PICO_ATMOS.cur->fres);
        _PICO_ATMOS.cur->fres = xfont;
        a_cpy(&_PICO_ATMOS.cur->font, dfont ? a_nil() : font);
    }
    if (style.type != A_NIL) {
        pico_set_pencil_style((PICO_STYLE) xstyle);
    }
    return A_OK;
}

// pico.set.scene [clear=, dim=, tile=, clip=, target=, source=]
static AStatus _pico_atmos_l_set_scene (AFunc* self, int argc, AVal* argv) {
    _PICO_ATMOS_IN("set.scene")
    AVal t = _PICO_ATMOS_ARG(0);
    _PICO_ATMOS_TRY(_pico_atmos_tab(t, "scene"));
    AVal clear = _pico_atmos_get(t, "clear");
    AVal vdim  = _pico_atmos_get(t, "dim");
    AVal vtile = _pico_atmos_get(t, "tile");
    AVal vclip = _pico_atmos_get(t, "clip");
    AVal vdst  = _pico_atmos_get(t, "target");
    AVal vsrc  = _pico_atmos_get(t, "source");

    Pico_Rel_Dim  dim,  *xdim=NULL;
    Pico_Rel_Dim  tile, *xtile=NULL;
    Pico_Rel_Rect clip, dst, src;
    if (a_truthy(clear) && (_PICO_ATMOS.cur->kind==_PICO_ATMOS_ROOT || _PICO_ATMOS.cur->kind==_PICO_ATMOS_SUB)) {
        return a_error("%s : unexpected 'clear'", _PICO_ATMOS_FN);
    }
    if (vdim.type != A_NIL) {
        _PICO_ATMOS_TRY(_pico_atmos_dim(vdim, &dim));
        if (dim.mode == '%') {
            return a_error("%s : invalid mode '%%' in 'dim'", _PICO_ATMOS_FN);
        }
        _PICO_ATMOS_TRY(_pico_atmos_resize(_PICO_ATMOS.cur));
        xdim = &dim;
    }
    if (vtile.type != A_NIL) {
        _PICO_ATMOS_TRY(_pico_atmos_dim(vtile, &tile));
        xtile = &tile;
    }
    if (vclip.type != A_NIL) { _PICO_ATMOS_TRY(_pico_atmos_rect(vclip, &clip)); }
    if (vdst.type  != A_NIL) { _PICO_ATMOS_TRY(_pico_atmos_rect(vdst,  &dst));  }
    if (vsrc.type  != A_NIL) { _PICO_ATMOS_TRY(_pico_atmos_rect(vsrc,  &src));  }

    if (clear.type != A_NIL) {
        pico_set_scene_clear(a_truthy(clear));
    }
    if (xdim!=NULL || xtile!=NULL) {
        pico_set_scene_dim_tile(xdim, xtile);
    }
    if (vclip.type != A_NIL) { pico_set_scene_clip(clip); }
    if (vdst.type  != A_NIL) { pico_set_scene_dst(dst);   }
    if (vsrc.type  != A_NIL) { pico_set_scene_src(src);   }
    return A_OK;
}

// pico.set.video(layer, frame)
static AStatus _pico_atmos_l_set_video (AFunc* self, int argc, AVal* argv) {
    _PICO_ATMOS_IN("set.video")
    _PICO_ATMOS_Lay* s;
    int frame;
    _PICO_ATMOS_TRY(_pico_atmos_lay(_PICO_ATMOS_ARG(0),&s) && _pico_atmos_int(_PICO_ATMOS_ARG(1),1,&frame));
    if (s->kind != _PICO_ATMOS_VIDEO) {
        return a_error("%s : not a video layer", _PICO_ATMOS_FN);
    }
    a_push(a_bool(pico_set_video(s->lay, frame)));
    return A_OK;
}

// pico.set.window [fullscreen=, show=, title=]
static AStatus _pico_atmos_l_set_window (AFunc* self, int argc, AVal* argv) {
    _PICO_ATMOS_IN("set.window")
    AVal t = _PICO_ATMOS_ARG(0);
    _PICO_ATMOS_TRY(_pico_atmos_tab(t, "window"));
    AVal fs    = _pico_atmos_get(t, "fullscreen");
    AVal show  = _pico_atmos_get(t, "show");
    AVal title = _pico_atmos_get(t, "title");
    if (title.type!=A_NIL && title.type!=A_STR) {
        return a_error("%s : expected string field 'title'", _PICO_ATMOS_FN);
    }
    if (fs.type    != A_NIL) { pico_set_window_fs(a_truthy(fs));            }
    if (show.type  != A_NIL) { pico_set_window_show(a_truthy(show));        }
    if (title.type != A_NIL) { pico_set_window_title(A_STR_OF(title)->s);   }
    return A_OK;
}

///////////////////////////////////////////////////////////////////////////////
// LAYER
///////////////////////////////////////////////////////////////////////////////

// A layer may host children if its texture is a render target.
static int _pico_atmos_hosts (_PICO_ATMOS_Lay* s) {
    if (s->kind == _PICO_ATMOS_SUB) {
        s = s->sup;
    }
    return s->kind==_PICO_ATMOS_ROOT || s->kind==_PICO_ATMOS_EMPTY;
}

// The common fields of the constructors: the table itself, `up`, and
// `target`.
typedef struct _PICO_ATMOS_Ctor {
    AVal          t;
    _PICO_ATMOS_Lay*       up;
    Pico_Layer*   xup;
    int           has_dst;
    Pico_Rel_Rect dst;
} _PICO_ATMOS_Ctor;

static int _pico_atmos_ctor (int argc, AVal* argv, _PICO_ATMOS_Ctor* c) {
    c->t = _PICO_ATMOS_ARG(0);
    if (!_pico_atmos_tab(c->t, "layer")) {
        return 0;
    }
    if (!_pico_atmos_lay_opt(_pico_atmos_get(c->t,"up"), &c->xup, &c->up)) {
        return 0;
    }
    if (c->up!=NULL && !_pico_atmos_hosts(c->up)) {
        a_error("%s : invalid 'up' : layer cannot host children", _PICO_ATMOS_FN);
        return 0;
    }
    AVal dst = _pico_atmos_get(c->t, "target");
    c->has_dst = (dst.type != A_NIL);
    return !c->has_dst || _pico_atmos_rect(dst, &c->dst);
}

// Applies the `target` to a new layer.
static void _pico_atmos_ctor_dst (_PICO_ATMOS_Ctor* c, Pico_Layer* lay) {
    if (c->has_dst) {
        Pico_Layer* old = pico_set_layer(lay);
        pico_set_scene_dst(c->dst);
        pico_set_layer(old);
    }
}

// Applies the `target`, and pushes the box of the new layer.
static AStatus _pico_atmos_ctor_end (_PICO_ATMOS_Ctor* c, Pico_Layer* lay, int kind, _PICO_ATMOS_Lay* sup) {
    _pico_atmos_ctor_dst(c, lay);
    a_push(_pico_atmos_lay_new(lay, kind, c->up, sup));
    return A_OK;
}

// A field with a path of a file.
static int _pico_atmos_path (AVal t, const char** path) {
    AVal v = _pico_atmos_get(t, "path");
    if (v.type != A_STR) {
        a_error("%s : required 'path'", _PICO_ATMOS_FN);
        return 0;
    }
    *path = A_STR_OF(v)->s;
    return _pico_atmos_file(*path);
}

// pico.layer.world()
static AStatus _pico_atmos_l_layer_world (AFunc* self, int argc, AVal* argv) {
    _PICO_ATMOS_IN("layer.world")
    a_pushc(_PICO_ATMOS.world);
    return A_OK;
}

// pico.layer.window()
static AStatus _pico_atmos_l_layer_window (AFunc* self, int argc, AVal* argv) {
    _PICO_ATMOS_IN("layer.window")
    a_pushc(_PICO_ATMOS.window);
    return A_OK;
}

// pico.layer.empty [up=, clear=, dim=, tile=, target=]
static AStatus _pico_atmos_l_layer_empty (AFunc* self, int argc, AVal* argv) {
    _PICO_ATMOS_IN("layer.empty")
    _PICO_ATMOS_Ctor c;
    _PICO_ATMOS_TRY(_pico_atmos_ctor(argc, argv, &c));
    int clear = a_truthy(_pico_atmos_get(c.t, "clear"));
    if (clear && c.up==NULL) {
        return a_error("%s : unexpected 'clear'", _PICO_ATMOS_FN);
    }
    AVal vdim = _pico_atmos_get(c.t, "dim");
    if (vdim.type == A_NIL) {
        vdim = _pico_atmos_get(c.t, "target");
        if (vdim.type == A_NIL) {
            return a_error("%s : 'dim' required", _PICO_ATMOS_FN);
        }
    }
    Pico_Rel_Dim dim, tile, *xtile=NULL;
    _PICO_ATMOS_TRY(_pico_atmos_dim(vdim, &dim));
    AVal vtile = _pico_atmos_get(c.t, "tile");
    if (vtile.type != A_NIL) {
        _PICO_ATMOS_TRY(_pico_atmos_dim(vtile, &tile));
        xtile = &tile;
    }
    return _pico_atmos_ctor_end(&c, pico_layer_empty(c.xup,clear,dim,xtile), _PICO_ATMOS_EMPTY, NULL);
}

// pico.layer.image [up=, path=, target=]
static AStatus _pico_atmos_l_layer_image (AFunc* self, int argc, AVal* argv) {
    _PICO_ATMOS_IN("layer.image")
    _PICO_ATMOS_Ctor c;
    const char* path;
    _PICO_ATMOS_TRY(_pico_atmos_ctor(argc,argv,&c) && _pico_atmos_path(c.t,&path));
    return _pico_atmos_ctor_end(&c, pico_layer_image(c.xup,path), _PICO_ATMOS_IMAGE, NULL);
}

// pico.layer.images [up=, path=, sheet=, target=]
//  - sheet=['#', w=cols, h=rows, n=count]: a vector, from left to right
//  - sheet=['!', name=Rect, ...]: a table with the same names
//  - target: the placement of each of the sub-layers, as in `pico.layer.sub`
static AStatus _pico_atmos_l_layer_images (AFunc* self, int argc, AVal* argv) {
    _PICO_ATMOS_IN("layer.images")
    _PICO_ATMOS_Ctor c;
    const char* path;
    _PICO_ATMOS_TRY(_pico_atmos_ctor(argc,argv,&c) && _pico_atmos_path(c.t,&path));
    AVal sheet = _pico_atmos_get(c.t, "sheet");
    _PICO_ATMOS_TRY(_pico_atmos_tab(sheet, "sheet"));
    AVal mode = a_tab_get(A_TAB_OF(sheet), a_int(0));
    char m = _pico_atmos_mode_s(mode);
    if (m!='#' && m!='!') {
        return a_error("%s : expected '#' or '!' mode", _PICO_ATMOS_FN);
    }

    // crops, all checked before any layer is created
    int n = 0;
    Pico_Rel_Rect* crops = NULL;
    AVal* names = NULL;
    if (m == '#') {
        float cols, rows, max;
        _PICO_ATMOS_TRY(_pico_atmos_num(sheet,"w",0,&cols) && _pico_atmos_num(sheet,"h",0,&rows)
            && _pico_atmos_num(sheet,"n",0,&max));
        if (cols<1 || rows<1) {
            return a_error("%s : mode '#' requires 'w' and 'h'", _PICO_ATMOS_FN);
        }
        Pico_Abs_Dim dim = pico_get_image(NULL, path);
        float tw = dim.w / (float)(int)cols;
        float th = dim.h / (float)(int)rows;
        n = (int)cols * (int)rows;
        if (max>=1 && max<n) {
            n = (int) max;
        }
        crops = malloc(n * sizeof(Pico_Rel_Rect));
        for (int i=0; i<n; i++) {
            crops[i] = (Pico_Rel_Rect) {
                '!', { (i%(int)cols)*tw, (i/(int)cols)*th, tw, th },
                PICO_ANCHOR_NW
            };
        }
    } else {
        ATab* tab = A_TAB_OF(sheet);
        crops = malloc((tab->an + tab->en + 1) * sizeof(Pico_Rel_Rect));
        names = malloc((tab->an + tab->en + 1) * sizeof(AVal));
        uint32_t pos = 0;
        AVal k, v;
        while (a_tab_next(tab, &pos, &k, &v)) {
            if (a_eq(k, a_int(0))) {
                continue;
            }
            if (!_pico_atmos_rect(v, &crops[n])) {
                free(crops);
                free(names);
                return A_ERROR;
            }
            names[n++] = k;
        }
    }

    AVal ret = a_tab();
    AVal img = _pico_atmos_lay_new(pico_layer_image(NULL,path), _PICO_ATMOS_IMAGE, NULL, NULL);
    _PICO_ATMOS_Lay* sup = a_nat_ptr(img);
    for (int i=0; i<n; i++) {
        Pico_Layer* lay = pico_layer_sub(c.xup, sup->lay, &crops[i]);
        _pico_atmos_ctor_dst(&c, lay);
        AVal sub = _pico_atmos_lay_new(lay, _PICO_ATMOS_SUB, c.up, sup);
        a_setindex(ret, (names == NULL) ? a_int(i) : names[i], sub);
        a_dec(sub);
    }
    a_dec(img);
    free(crops);
    free(names);
    a_push(ret);
    return A_OK;
}

// pico.layer.pixmap [up=, pixels=|pixmap=, target=]
static AStatus _pico_atmos_l_layer_pixmap (AFunc* self, int argc, AVal* argv) {
    _PICO_ATMOS_IN("layer.pixmap")
    _PICO_ATMOS_Ctor c;
    _PICO_ATMOS_TRY(_pico_atmos_ctor(argc, argv, &c));
    AVal pixels = _pico_atmos_get(c.t, "pixels");
    if (pixels.type == A_NIL) {
        pixels = _pico_atmos_get(c.t, "pixmap");
    }
    Pico_Abs_Dim dim;
    Pico_Color* buf;
    _PICO_ATMOS_TRY(_pico_atmos_pixmap(pixels, &dim, &buf));
    Pico_Layer* lay = pico_layer_pixmap(c.xup, dim, buf);
    free(buf);
    return _pico_atmos_ctor_end(&c, lay, _PICO_ATMOS_PIXMAP, NULL);
}

// pico.layer.screenshot [up=, sup=|src=, crop=|rect=, target=]
static AStatus _pico_atmos_l_layer_screenshot (AFunc* self, int argc, AVal* argv) {
    _PICO_ATMOS_IN("layer.screenshot")
    _PICO_ATMOS_Ctor c;
    _PICO_ATMOS_TRY(_pico_atmos_ctor(argc, argv, &c));
    AVal vsup = _pico_atmos_get(c.t, "sup");
    if (vsup.type == A_NIL) {
        vsup = _pico_atmos_get(c.t, "src");
    }
    AVal vcrop = _pico_atmos_get(c.t, "crop");
    if (vcrop.type == A_NIL) {
        vcrop = _pico_atmos_get(c.t, "rect");
    }
    Pico_Layer* sup;
    Pico_Rel_Rect crop, *xcrop=NULL;
    _PICO_ATMOS_TRY(_pico_atmos_lay_opt(vsup, &sup, NULL));
    if (vcrop.type != A_NIL) {
        _PICO_ATMOS_TRY(_pico_atmos_rect(vcrop, &crop));
        xcrop = &crop;
    }
    return _pico_atmos_ctor_end(&c, pico_layer_screenshot(c.xup,sup,xcrop), _PICO_ATMOS_SHOT, NULL);
}

// pico.layer.sub [up=, sup=, crop=, target=]
static AStatus _pico_atmos_l_layer_sub (AFunc* self, int argc, AVal* argv) {
    _PICO_ATMOS_IN("layer.sub")
    _PICO_ATMOS_Ctor c;
    _PICO_ATMOS_TRY(_pico_atmos_ctor(argc, argv, &c));
    AVal vsup  = _pico_atmos_get(c.t, "sup");
    AVal vcrop = _pico_atmos_get(c.t, "crop");
    if (vsup.type == A_NIL) {
        return a_error("%s : required 'sup'", _PICO_ATMOS_FN);
    }
    if (vcrop.type == A_NIL) {
        return a_error("%s : required 'crop'", _PICO_ATMOS_FN);
    }
    _PICO_ATMOS_Lay* sup;
    Pico_Rel_Rect crop;
    _PICO_ATMOS_TRY(_pico_atmos_lay(vsup,&sup) && _pico_atmos_rect(vcrop,&crop));
    if (sup->kind == _PICO_ATMOS_SUB) {
        return a_error("%s : invalid 'sup' : sub-layer of a sub-layer", _PICO_ATMOS_FN);
    }
    return _pico_atmos_ctor_end(&c, pico_layer_sub(c.xup,sup->lay,&crop), _PICO_ATMOS_SUB, sup);
}

// pico.layer.text [up=, dim=, text=, target=]
static AStatus _pico_atmos_l_layer_text (AFunc* self, int argc, AVal* argv) {
    _PICO_ATMOS_IN("layer.text")
    _PICO_ATMOS_Ctor c;
    _PICO_ATMOS_TRY(_pico_atmos_ctor(argc, argv, &c));
    AVal vdim = _pico_atmos_get(c.t, "dim");
    if (vdim.type != A_TAB) {
        return a_error("%s : required 'dim' table", _PICO_ATMOS_FN);
    }
    Pico_Rel_Dim dim;
    _PICO_ATMOS_TRY(_pico_atmos_dim(vdim, &dim));
    if (dim.h==0 || dim.w!=0) {
        return a_error("%s : invalid 'dim' : expected 'h' only", _PICO_ATMOS_FN);
    }
    AVal vtext = _pico_atmos_get(c.t, "text");
    AVal text;
    if (vtext.type!=A_STR && !a_isnum(vtext)) {
        return a_error("%s : required 'text'", _PICO_ATMOS_FN);
    }
    _PICO_ATMOS_TRY(_pico_atmos_text(vtext, 0, &text));
    if (A_STR_OF(text)->len == 0) {
        a_dec(text);
        return a_error("%s : required 'text'", _PICO_ATMOS_FN);
    }
    Pico_Layer* lay = pico_layer_text(c.xup, dim, A_STR_OF(text)->s);
    a_dec(text);
    return _pico_atmos_ctor_end(&c, lay, _PICO_ATMOS_TEXT, NULL);
}

// pico.layer.video [up=, path=, target=]
static AStatus _pico_atmos_l_layer_video (AFunc* self, int argc, AVal* argv) {
    _PICO_ATMOS_IN("layer.video")
    _PICO_ATMOS_Ctor c;
    const char* path;
    _PICO_ATMOS_TRY(_pico_atmos_ctor(argc,argv,&c) && _pico_atmos_path(c.t,&path));
    return _pico_atmos_ctor_end(&c, pico_layer_video(c.xup,path), _PICO_ATMOS_VIDEO, NULL);
}

