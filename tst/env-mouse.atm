;; The loop of pico, in test mode unless the variables are already set:
;;  - 12 frames of 20ms each, then :quit
;;  - the mouse moves at frame 2, presses at frame 4, drags at frame 6,
;;    releases and moves away at frame 8 (in pixels of the window, 500x500)
;;  - screenshot at frame 7
`setenv("PICO_ATM_FRAMES", "12:20", 0);`
`setenv("PICO_ATM_MOUSE", "2:mv:100:50,4:dn:250:250,6:mv:300:260,8:up:300:260,8:mv:10:20", 0);`
`setenv("PICO_ATM_SHOT", "7:../c/tst/out/env-mouse-01.png", 0);`

pico.set.window [ title="Env Mouse" ]
val window = pico.layer.window()

;; the fields of a table, sorted, with the types of their values
func shape (t) {
    val ks = []
    loop k,v in t {
        set ks@+ = tostring(k) ++ ":" ++ type(v)
    }
    vector.sort(ks)
    var s = ""
    loop _,k in ks {
        set s = s ++ k ++ " "
    }
    s
}

;; a real event, from the warp of the mouse, to compare with the scripted ones
pico.set.mouse(window, ['!', x=30, y=40, anchor='NW'])
val real = pico.input.event('mouse.motion', 500)
assert(real, "no real event")
print("real", real.tag, shape(real), shape(real.anchor))
assert(real@0=='!' && real.x==30.5 && real.y==40.5)

;; a scripted event: the tag, the position in the window, the left button
func check (e, tag, x, y, left) {
    print(e.tag, e@0, e.x, e.y, e.anchor.x, e.anchor.y, e.left, e.right, e.middle)
    assert(e.tag == tag)
    assert(e ?? :mouse)
    assert(shape(e) == shape(real), "shape")
    assert(shape(e.anchor) == shape(real.anchor), "shape of anchor")
    ;; pixels of the window, anchor 'C'
    assert(e@0 == '!')
    assert(e.x==x+0.5 && e.y==y+0.5)
    assert(e.anchor.x==0.5 && e.anchor.y==0.5)
    assert(e.left==left && e.right==false && e.middle==false)
    ;; `pico.get.mouse` agrees with the event, in any layer and mode
    val m1 = pico.get.mouse(window, '!')
    assert(m1.x==e.x && m1.y==e.y && m1.left==left)
    val m2 = pico.get.mouse(window, ['!', anchor='NW'])
    assert(m2.x==x && m2.y==y && m2.left==left)
    val m3 = pico.get.mouse(['%', anchor='NW'])     ;; world
    assert(pico.equal(m3.x,x/500) && pico.equal(m3.y,y/500) && m3.left==left)
    val m4 = pico.get.mouse(['!', anchor='NW'])     ;; world: 100x100
    assert(pico.equal(m4.x,x/5) && pico.equal(m4.y,y/5))
}

var frames = 0      ;; number of :draw
var n      = 0      ;; number of mouse events
var x      = 10     ;; position of the rect, dragged by the mouse
var y      = 10

par :any {
    ;; redraws at every frame
    loop on :draw {
        set frames = frames + 1
        pico.set.pencil [ color='red' ]
        pico.output.draw.rect(['!', x=x, y=y, w=10, h=10, anchor='NW'])
    }
} with {
    loop on :mouse {
        set n = n + 1
    }
} with {
    val e1 = await :mouse.motion
    assert(frames == 1)                 ;; before the :draw of frame 2
    check(e1, 'mouse.motion', 100, 50, false)

    ;; drags the rect while the button is down
    val e2 = await :mouse.button.dn
    assert(frames == 3)
    check(e2, 'mouse.button.dn', 250, 250, true)
    par :any {
        loop e on :mouse.motion {
            assert(frames == 5)
            check(e, 'mouse.motion', 300, 260, true)
            val m = pico.get.mouse(['!', anchor='NW'])
            set x = m.x
            set y = m.y
        }
    } with {
        val e3 = await :mouse.button.up
        assert(frames == 7)
        check(e3, 'mouse.button.up', 300, 260, false)
    }

    ;; the second entry of frame 8
    val e4 = await :mouse.motion
    assert(frames == 7)
    check(e4, 'mouse.motion', 10, 20, false)
    await false
} with {
    await :mouse.button.dn [left=true]
    print("left", frames)
    await false
} with {
    val e = await :quit
    print("quit", e.tag, frames, n)
}
assert(frames==12 && n==5)
print("rect", x, y)
assert(pico.equal(x,60) && pico.equal(y,52))

;; with no more entries, the mouse stays where the script left it
do {
    val m = pico.get.mouse(window, ['!', anchor='NW'])
    assert(m.x==10 && m.y==20 && m.left==false)
}

;; the screenshot of frame 7: the rect where the mouse dragged it
pico.set.expert(false)
pico.output.clear()
pico.set.pencil [ color='red' ]
pico.output.draw.rect(['!', x=60, y=52, w=10, h=10, anchor='NW'])
pico.output.screenshot(window, "../c/tst/out/env-mouse-02.png")

func same (a, b) {
    val f1 = io.open(a, "rb")
    val f2 = io.open(b, "rb")
    val c1 = io.read(f1, :all)
    val c2 = io.read(f2, :all)
    io.close(f1)
    io.close(f2)
    c1 == c2
}
assert(same("../c/tst/out/env-mouse-01.png", "../c/tst/out/env-mouse-02.png"), "env-mouse-01 vs env-mouse-02")

;; `pico.set.mouse` brings the real mouse back
pico.set.mouse(window, ['!', x=70, y=90, anchor='NW'])
do {
    val m = pico.get.mouse(window, ['!', anchor='NW'])
    assert(m.x==70 && m.y==90)
}

print("ok")
pico.close()
