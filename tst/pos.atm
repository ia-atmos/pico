pico.set.window [ title="Pct-To-Pos" ]

do {
    print("white centered rect")
    pico.output.clear()
    pico.output.draw.rect(['%', x=0.5, y=0.5, w=0.5, h=0.5])
    pico.check("pos-01")
}

do {
    pico.output.clear()

    print("white rect at 30%")
    val r1 = ['%', x=0.3, y=0.3, w=0.5, h=0.5]
    pico.output.draw.rect(r1)

    print("red centered under white")
    val r2 = pico.in.rect(r1, ['%', x=0.5, y=0.5, w=0.5, h=0.5])
    pico.set.pencil [ color='red' ]
    pico.output.draw.rect(r2)

    pico.check("pos-02")
}

do {
    pico.output.clear()

    print("rect at 50% anchored by bottom-right")
    val r1 = ['%', x=0.5, y=0.5, w=0.5, h=0.5, anchor='SE']
    pico.set.pencil [ color='white' ]
    pico.output.draw.rect(r1)

    print("red anchored by top-left under 0% of white")
    val r2 = pico.in.rect(r1, ['%', x=0, y=0, w=0.5, h=0.5, anchor='NW'])
    pico.set.pencil [ color='red' ]
    pico.output.draw.rect(r2)

    pico.check("pos-03")
}

do {
    print("rect at -10/-10 top-left (4x7 rect on top)")
    pico.output.clear()
    val r = ['%', x=-0.1, y=-0.1, w=0.15, h=0.3, anchor='NW']
    pico.set.pencil [ color='white' ]
    pico.output.draw.rect(r)
    pico.check("pos-04")
}

do {
    print("rect at 110/110 bottom-right (symmetric to previous)")
    pico.output.clear()
    val r = ['%', x=1.1, y=1.1, w=0.15, h=0.3, anchor='SE']
    pico.set.pencil [ color='white' ]
    pico.output.draw.rect(r)
    pico.check("pos-05")
}

do {
    pico.output.clear()

    print("rect at 50% anchored by center")
    val r1 = ['%', x=0.5, y=0.5, w=0.5, h=0.5]
    pico.set.pencil [ color='white' ]
    pico.output.draw.rect(r1)

    print("red anchored by top-left under -10% of white")
    val r2 = pico.in.rect(r1, ['%', x=-0.1, y=-0.1, w=0.5, h=0.5, anchor='NW'])
    pico.set.pencil [ color='red' ]
    pico.output.draw.rect(r2)

    pico.check("pos-06")
}

do {
    pico.output.clear()

    print("rect at 50%")
    val r1 = ['%', x=0.5, y=0.5, w=0.5, h=0.5]
    pico.set.pencil [ color='white' ]
    pico.output.draw.rect(r1)

    print("red anchored by top-left under 110% of white (symmetric to previous)")
    val r2 = pico.in.rect(r1, ['%', x=1.1, y=1.1, w=0.5, h=0.5, anchor='SE'])
    pico.set.pencil [ color='red' ]
    pico.output.draw.rect(r2)

    pico.check("pos-07")
}

pico.close()
