val W = 640
val H = 480

pico.set.window [ title="Storm" ]
pico.set.dim ['!', w=W, h=H]
pico.set.effect [ color=[ r=0x21, g=0x2C, b=0x34 ] ]

math.randomseed(os.time())

;; Shared game state accessible by all entities
pin G = [
    W  = W,
    H  = H,
    PI = math.pi,
]

include "ts.atm"

pin drops  = tasks()
pin clouds = tasks()
pin booms  = tasks()
pin lights = tasks()

set G.drops  = drops
set G.clouds = clouds
set G.booms  = booms
set G.lights = lights

pin car = spawn Car(G)
set G.car = car

spawn Clouds(G)
spawn Collisions(G)

;; DEBUG: press Down to spawn lightning
spawn {
    loop {
        await :key.dn [key='Down']
        spawn @lights Light(
            G, [ x=300, y=0 ], 270, 50, false
        )
    }
}

await(false)
