val phy = ['!', w=200, h=200]
val log = ['!', w=20, h=20]
pico.set.layer(pico.layer.window())
pico.set.scene [ dim=phy ]
pico.set.layer(pico.layer.world())
pico.set.scene [ dim=log ]

val r = ['!', x=10-2, y=10-2, w=4, h=4, anchor='NW']

print("pos_vs_rect")
;; (`on` is a keyword in Atmos: the Lua variable `on` is `on_`)
loop y in (r.y-1, r.y+r.h) {
    loop x in (r.x-1, r.x+r.w) {
        pico.output.clear()
        pico.set.pencil [ color='white' ]
        pico.output.draw.rect(r)

        val p = ['!', x=x, y=y, anchor='NW']
        pico.set.pencil [ color='red' ]
        pico.output.draw.pixel(p)

        val on_ = pico.vs.pos.rect(nil, p, nil, r)
        ;;print(if on_ => "in" => "out")
        pico.input.delay(10)

        if x==7 && y==7 {
            assert(!on_)
            pico.check("collide_raw-01")
        }
        if x==8 && y==8 {
            assert(on_)
            pico.check("collide_raw-02")
        }
        if x==9 && y==9 {
            assert(on_)
            pico.check("collide_raw-03")
        }
        if x==10 && y==10 {
            assert(on_)
            pico.check("collide_raw-04")
        }
        if x==11 && y==11 {
            assert(on_)
            pico.check("collide_raw-05")
        }
        if x==12 && y==12 {
            assert(!on_)
            pico.check("collide_raw-06")
        }
    }
}

print("rect_vs_rect")
loop y in (r.y-r.h, r.y+r.h) {
    loop x in (r.x-r.w, r.x+r.w) {
        pico.output.clear()
        pico.set.pencil [ color='white' ]
        pico.output.draw.rect(r)

        val r2 = ['!', x=x, y=y, w=4, h=4, anchor='NW']
        pico.set.pencil [ color='red' ]
        pico.output.draw.rect(r2)

        val overlap = pico.vs.rect.rect(r2, r)
        ;;print(if overlap => "overlap" => "naw")
        pico.input.delay(10)

        if x==4 && y==4 {
            assert(!overlap)
            pico.check("collide_raw-07")
        }
        if x==5 && y==5 {
            assert(overlap)
            pico.check("collide_raw-08")
        }
        if x==11 && y==11 {
            assert(overlap)
            pico.check("collide_raw-09")
        }
        if x==12 && y==12 {
            assert(!overlap)
            pico.check("collide_raw-10")
        }
    }
}

pico.close()
