val phy = ['!', w=200, h=200]
val log = ['!', w=10, h=10]
pico.set.window [ title="Anchoring..." ]
pico.set.layer(pico.layer.window())
pico.set.scene [ dim=phy ]
pico.set.layer(pico.layer.world())
pico.set.scene [ dim=log ]

;; PIXELS
do {
    print("centered pixel - 1dir/1baixo")
    val p = ['%', x=0.5, y=0.50, anchor='C']
    pico.output.clear()
    pico.output.draw.pixel(p)
    pico.check("anchor-01")
}

do {
    print("centered pixel - 1dir/1baixo")
    val p = ['%', x=0.5, y=0.5, anchor='NW']
    pico.output.clear()
    pico.output.draw.pixel(p)
    pico.check("anchor-02")
}

do {
    print("centered pixel - 1esq/1cima")
    val p = ['%', x=0.5, y=0.5, anchor='SE']
    pico.output.clear()
    pico.output.draw.pixel(p)
    pico.check("anchor-03")
}

;; RECTS
do {
    print("centered rect - exact")
    val r = ['%', x=0.5, y=0.5, w=0.4, h=0.4, anchor='C']
    pico.output.clear()
    pico.output.draw.rect(r)
    pico.check("anchor-04")
}

do {
    print("topleft centered - 1lin/1col")
    val r = ['%', x=0.5, y=0.5, w=0.4, h=0.4, anchor='NW']
    pico.output.clear()
    pico.output.draw.rect(r)
    pico.check("anchor-05")
}

do {
    print("bottomright centered - 1lin/1col")
    val r = ['%', x=0.5, y=0.5, w=0.4, h=0.4, anchor='SE']
    pico.output.clear()
    pico.output.draw.rect(r)
    pico.check("anchor-06")
}

do {
    print("rightmiddle centered - 1col")
    val r = ['%', x=0.5, y=0.5, w=0.4, h=0.4, anchor='E']
    pico.output.clear()
    pico.output.draw.rect(r)
    pico.check("anchor-07")
}

do {
    print("anchor 25%25% 20%20% - 1lin/1col")
    val r = ['%', x=0.2, y=0.2, w=0.4, h=0.4, anchor=[x=0.2,y=0.2]]
    pico.output.clear()
    pico.output.draw.rect(r)
    pico.check("anchor-08")
}

;; RECTS out of [0,100]
do {
    print("anchor -25%-25% centered - touching border")
    val r = ['%', x=0.5, y=0.5, w=0.4, h=0.4, anchor=[x=-0.25,y=-0.25]]
    pico.output.clear()
    pico.output.draw.rect(r)
    pico.check("anchor-09")
}

do {
    print("anchor 125%125% centered - touching border")
    val r = ['%', x=0.5, y=0.5, w=0.4, h=0.4, anchor=[x=1.25,y=1.25]]
    pico.output.clear()
    pico.output.draw.rect(r)
    pico.check("anchor-10")
}

pico.close()
