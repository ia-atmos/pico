;; The loop of pico, in test mode unless the variables are already set:
;;  - 12 frames of 20ms each, then :quit
;;  - key A pressed at frame 4, released at frame 6; key B pressed at frame 6
;;  - screenshot at frame 8
`setenv("PICO_ATM_FRAMES", "12:20", 0);`
`setenv("PICO_ATM_KEYS", "4:dn:A,6:up:A,6:dn:B", 0);`
`setenv("PICO_ATM_SHOT", "8:../c/tst/out/env-01.png", 0);`

pico.set.window [ title="Env" ]

var frames = 0      ;; number of :draw
var us     = 0      ;; time passed, from :clock
var x      = 10     ;; position of the rect, moved by the keys

par :any {
    ;; redraws at every frame
    loop on :draw {
        set frames = frames + 1
        pico.set.pencil [ color='red' ]
        pico.output.draw.rect(['!', x=x, y=45, w=10, h=10, anchor='NW'])
    }
} with {
    loop dt on :clock {
        set us = us + dt
    }
} with {
    ;; time: 50ms is in the middle of frame 3
    await 50ms
    print("50ms", frames, us)
    await 100ms
    print("150ms", frames, us)
    await false
} with {
    ;; keys
    val dn = await :key.dn
    print("key.dn", dn.key, dn.ctrl, dn.shift, dn.alt, frames)
    set x = 40
    val up = await :key.up
    print("key.up", up.key, frames)
    await false
} with {
    await :key.dn [key='B']
    print("key.dn B", frames)
    set x = 70
    await false
} with {
    val e = await :quit
    print("quit", e.tag, frames, us)
}

;; the screenshot of frame 8: the rect at x=70, after key B
val f = io.open("../c/tst/out/env-01.png", "rb")
assert(f, "no screenshot")
io.close(f)
val win = pico.layer.window()
val shot = pico.output.screenshot(win, "../c/tst/out/env-02.png")
print("expert", pico.get.expert())

;; the same picture drawn by hand must match the screenshot of the loop
pico.set.expert(false)
pico.output.clear()
pico.set.pencil [ color='red' ]
pico.output.draw.rect(['!', x=70, y=45, w=10, h=10, anchor='NW'])
pico.output.screenshot(win, "../c/tst/out/env-03.png")

func same (a, b) {
    val f1 = io.open(a, "rb")
    val f2 = io.open(b, "rb")
    val c1 = io.read(f1, :all)
    val c2 = io.read(f2, :all)
    io.close(f1)
    io.close(f2)
    c1 == c2
}
assert(same("../c/tst/out/env-01.png", "../c/tst/out/env-03.png"), "env-01 vs env-03")
assert(same("../c/tst/out/env-02.png", "../c/tst/out/env-03.png"), "env-02 vs env-03")
print("ok")

pico.close()
