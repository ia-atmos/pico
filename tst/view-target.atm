include "../pico.atm"

pico.open()
pico.set.window [ title="View Target" ]

;; 01: target = bottom-right quadrant, draw centered rect
do {
    print("target: bottom-right quadrant")
    pico.set.scene [
        target = ['%', x=1, y=1, w=0.5, h=0.5, anchor='SE']
    ]
    pico.output.clear()
    pico.output.draw.rect(['%', x=0.5, y=0.5, w=0.5, h=0.5])
    pico.check("view-target-01")
}

;; 02: same target, r2 nested inside r1
do {
    print("target: r2 inside r1")
    pico.output.clear()
    val r1 = ['%', x=0.5, y=0.5, w=0.5, h=0.5]
    pico.output.draw.rect(r1)
    val r2 = pico.in.rect(r1, ['%', x=0.5, y=0.5, w=0.5, h=0.5])
    pico.set.pencil [ color='red' ]
    pico.output.draw.rect(r2)
    pico.check("view-target-02")
}

;; 03: reset target, draw same — should fill full window
do {
    print("target: reset to full window")
    pico.set.scene [
        target = ['%', x=0.5, y=0.5, w=1, h=1]
    ]
    pico.output.clear()
    pico.set.pencil [ color='white' ]
    pico.output.draw.rect(['%', x=0.5, y=0.5, w=0.5, h=0.5])
    pico.check("view-target-03")
}

;; 04: explicit layer with view target, drawn with rect=NULL
;; (the layer is declared out of the block: it is also used in 04b)
val bg = pico.layer.empty [ dim=['!', w=32, h=32] ]
do {
    print("target: explicit layer")
    pico.set.layer(bg)
    pico.set.effect [ color=[r=0x80, g=0x00, b=0x00] ]
    pico.output.clear()
    pico.set.pencil [ color='white' ]
    pico.output.draw.rect(['%', x=0.5, y=0.5, w=0.5, h=0.5])
    pico.set.layer(pico.layer.world())
    pico.set.effect [ color='black' ]
    pico.output.clear()
    pico.output.draw.layer(bg, ['%', x=1, y=1, w=0.5, h=0.5, anchor='SE'])
    pico.check("view-target-04")
}

;; 04b: detached stored target == explicit-rect draw. Storing bg's
;;      target and drawing with no rect must render identically to the
;;      explicit-rect blit of test 04. Runs before bg2 (an attached
;;      child of world) exists, so the cascade adds nothing.
do {
    print("target: detached stored target matches explicit rect (04)")
    pico.set.layer(bg)
    pico.set.scene [ target = ['%', x=1, y=1, w=0.5, h=0.5, anchor='SE'] ]
    pico.set.layer(pico.layer.world())
    pico.set.effect [ color='black' ]
    pico.output.clear()
    pico.output.draw.layer(bg)
    pico.check("view-target-04")
}

;; 05: target h only, w=0 -> w inferred from 2:1 layer aspect
;; (the layer is declared out of the block: it is also used in 06, 07, and
;; remains attached to the world until the end)
val bg2 = pico.layer.empty [ up=pico.layer.world(), dim=['!', w=80, h=40] ]
do {
    print("target: h only, w inferred")
    pico.set.layer(bg2)
    pico.set.scene [
        target = ['%', x=0.5, y=0.5, h=0.4]
    ]
    pico.set.effect [ color=[r=0x80, g=0x00, b=0x00] ]
    pico.output.clear()
    pico.set.layer(pico.layer.world())
    pico.set.effect [ color='black' ]
    pico.output.clear()
    pico.output.draw.layer(bg2)
    pico.check("view-target-05")
}

;; 06: target w only, h=0 -> h inferred from 2:1 layer aspect
do {
    print("target: w only, h inferred")
    pico.set.layer(bg2)
    pico.set.scene [
        target = ['%', x=0.5, y=0.5, w=0.4, h=0]
    ]
    pico.set.layer(pico.layer.world())
    pico.output.clear()
    pico.output.draw.layer(bg2)
    pico.check("view-target-06")
}

;; 07: target w=h=0 -> full layer dim
do {
    print("target: w=h=0, full layer dim")
    pico.set.layer(bg2)
    pico.set.scene [
        target = ['%', x=0, y=0, w=0, anchor='NW']
    ]
    pico.set.layer(pico.layer.world())
    pico.output.clear()
    pico.output.draw.layer(bg2)
    pico.check("view-target-07")
}

;; 08: rect-as-dim shortcut: same effect as test 04 (dim + scene.target)
;;     in one call. Rect's mode/w/h are used as the layer Dim, full rect
;;     becomes scene.target.
do {
    print("target: rect-as-dim shortcut")
    val r = ['%', x=1, y=1, w=0.5, h=0.5, anchor='SE']
    val bg3 = pico.layer.empty [ up=pico.layer.world(), target=r ]
    pico.set.layer(bg3)
    pico.set.effect [ color=[r=0x80, g=0x00, b=0x00] ]
    pico.output.clear()
    pico.set.pencil [ color='white' ]
    pico.output.draw.rect(['%', x=0.5, y=0.5, w=0.5, h=0.5])
    pico.set.layer(pico.layer.world())
    pico.set.effect [ color='black' ]
    pico.output.clear()
    pico.output.draw.layer(bg3)
    pico.check("view-target-08")
}

pico.close()
