include "../pico.atm"

pico.open()
pico.set.window [ title="Set Test" ]
pico.set.layer(pico.layer.window())
pico.set.scene [ dim=['!', w=640, h=480] ]
pico.set.layer(pico.layer.world())
pico.set.scene [ dim=['!', w=64, h=48] ]

;; set all: alpha comparison (left=0x80, right=0xFF)
do {
    print("set all: alpha comparison")
    pico.output.clear()
    pico.set.pencil [ color=pico.color.alpha('red', 0x80) ]
    pico.output.draw.rect(['%', x=0.25, y=0.5, w=0.4, h=0.8])
    pico.set.pencil [ color=pico.color.alpha('red', 0xFF) ]
    pico.output.draw.rect(['%', x=0.75, y=0.5, w=0.4, h=0.8])
    pico.check("set-01")
}

;; set all: style (stroke rect)
do {
    print("set all: style")
    pico.output.clear()
    pico.set.pencil [ style='stroke', color='white' ]
    pico.output.draw.rect(['%', x=0.5, y=0.5, w=0.8, h=0.8])
    pico.check("set-02")
}

;; individual setters (green rect with alpha)
do {
    print("individual setters")
    pico.output.clear()
    pico.set.pencil [ color=pico.color.alpha('green', 0xCC) ]
    pico.output.draw.rect(['%', x=0.5, y=0.5, w=0.5, h=0.5])
    pico.check("set-03")
}

pico.close()
