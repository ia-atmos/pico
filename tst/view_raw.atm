include "../pico.atm"

pico.open()

;; TITLE
print("title: set and get")
pico.set.window [ title="Test Title" ]
val win = pico.get.window()
assert(win.title == "Test Title", "title mismatch: " ++ tostring(win.title))
pico.set.window [ title="View Raw" ]

pico.set.layer(pico.layer.window())
val window = pico.get.scene().dim
pico.set.layer(pico.layer.world())
var all = pico.get.scene()
val world = all.dim
assert(window.w == 500 && window.h == 500)
assert(world.w == 100 && world.h == 100)
set window@0 = '!'
set world@0 = '!'

;; SIZE (using set.dim for both window and world)
pico.set.dim(window)
set all = pico.get.scene()
assert(all.dim.w==window.w && all.dim.h==window.h)
pico.set.scene [ dim=world ]   ;; fallback after test

;; WORLD - bigger
print("shows lower-left X, center rect, center/up-right line")
loop i in (0,49) {
    set world.w = world.w + 1
    set world.h = world.h + 1
    pico.set.scene [ dim = world ]
    pico.output.clear()
    pico.set.pencil [ color='white' ]
    pico.output.draw.rect(['!',
        x = world.w//2 - 5,
        y = world.h//2 - 5,
        w = 10,
        h = 10,
        anchor = 'NW'
    ])
    pico.set.pencil [ color='red' ]
    pico.output.draw.line(
        ['%', x=0.5, y=0.5],
        ['%', x=1.0, y=0]
    )
    pico.input.delay(10)
    ifs {
        i == 0  => pico.check("view_raw-01")
        i == 48 => pico.check("view_raw-02")
    }
}

;; SCROLL - left/up
print("scrolls left/up")
loop i in (0,49) {
    pico.set.scene [
        source = ['!', x=i, y=i, w=100, h=100, anchor='NW']
    ]
    pico.output.clear()
    pico.output.draw.text("Uma frase bem grande...", ['!', x=10, y=50, w=0, h=10, anchor='NW'])
    pico.input.delay(10)
    ifs {
        i == 0  => pico.check("view_raw-03")
        i == 49 => pico.check("view_raw-04")
    }
}

pico.close()
