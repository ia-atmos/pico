// pico.output.screenshot([layer [, path] [, rect]]): the path
static AStatus _pico_atmos_l_output_screenshot (AFunc* self, int argc, AVal* argv) {
    _PICO_ATMOS_IN("output.screenshot")
    Pico_Layer* lay;
    _PICO_ATMOS_TRY(_pico_atmos_lay_opt(_PICO_ATMOS_ARG(0), &lay, NULL));
    AVal a1 = _PICO_ATMOS_ARG(1);
    AVal a2 = _PICO_ATMOS_ARG(2);
    const char* path = (a1.type == A_STR) ? A_STR_OF(a1)->s : NULL;
    AVal vrect = (a1.type == A_TAB) ? a1 : a2;
    if (a1.type!=A_NIL && a1.type!=A_STR && a1.type!=A_TAB) {
        return _pico_atmos_bad(1, "string or rect", a1);
    }
    Pico_Rel_Rect rect, *xrect=NULL;
    if (vrect.type != A_NIL) {
        _PICO_ATMOS_TRY(_pico_atmos_rect(vrect, &rect));
        xrect = &rect;
    }
    a_push(a_strn(pico_output_screenshot(lay, path, xrect)));
    return A_OK;
}

