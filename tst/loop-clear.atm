include "../pico.atm"

;; The clear of each frame of the loop always applies to the world, even if
;; the program awaits with another layer as the current one. It cascades to
;; the children with `clear=true` only, and the current layer is restored.
`setenv("PICO_ATM_FRAMES", "3:20", 0);`

pico.open [ title="Loop clear" ]

val OUT   = "../c/tst/out/"
val world = pico.layer.world()

;; two children of the world, and a detached layer
val acc = pico.layer.empty [ up=world, dim=['!',w=40,h=10],
    target=['!', x=5, y=40, w=40, h=10, anchor='NW'] ]
val clr = pico.layer.empty [ up=world, clear=true, dim=['!',w=40,h=10],
    target=['!', x=55, y=40, w=40, h=10, anchor='NW'] ]
val other = pico.layer.empty [ dim=['!',w=40,h=10] ]

func bytes (path) {
    val f = io.open(path, "rb")
    assert(f, "cannot open " ++ path)
    val c = io.read(f, :all)
    io.close(f)
    c
}

;; a mark for the frame `n` in the current layer
func mark (n) {
    pico.output.draw.rect(['!', x=n*10, y=2, w=5, h=5, anchor='NW'])
}

;; the marks of the frames `fr` to 3 in a layer
func marks (l, fr) {
    pico.set.layer(l)
    pico.output.clear()
    loop n in (fr,3) {
        mark(n)
    }
}

;; the window with the given first frames in the world, `acc` and `clr`
func hand (name, w, a, c) {
    marks(world, w)                     ;; first: its clear cascades to `clr`
    marks(acc, a)
    marks(clr, c)
    pico.output.present()
    bytes(pico.output.screenshot(pico.layer.window(), OUT ++ name))
}

var frames = 0
par :any {
    loop on :draw {
        assert(pico.get.layer() == other, "current layer not restored")
        set frames = frames + 1
        pico.set.layer(world)
        mark(frames)
        pico.set.layer(acc)
        mark(frames)
        pico.set.layer(clr)
        mark(frames)
        pico.set.layer(other)           ;; awaits with another layer current
        mark(frames)
    }
} with {
    pico.set.layer(other)
    await :quit
}
assert(frames == 3)
assert(pico.get.layer() == other)

val got = bytes(pico.output.screenshot(pico.layer.window(), OUT ++ "loop-clear-01.png"))

;; `other` was never cleared by the loop: its 3 marks are still there
val oth = bytes(pico.output.screenshot(other, OUT ++ "loop-clear-02.png"))

;; (still in expert mode, as the loop leaves it: only `hand` presents)
val exp = hand("loop-clear-03.png", 3, 1, 3)    ;; world: 3; acc: 1,2,3; clr: 3
assert(got == exp, "world must not accumulate; acc must; clr must not")
assert(got != hand("loop-clear-04.png", 1, 1, 3), "world accumulates")
assert(got != hand("loop-clear-05.png", 3, 3, 3), "acc does not accumulate")
assert(got != hand("loop-clear-06.png", 3, 1, 1), "clr accumulates")

marks(other, 1)
assert(oth == bytes(pico.output.screenshot(other, OUT ++ "loop-clear-07.png")))
marks(other, 3)
assert(oth != bytes(pico.output.screenshot(other, OUT ++ "loop-clear-08.png")))
pico.set.layer(world)
print("ok")
