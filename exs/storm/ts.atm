;;
;; ts.atm — Entity functions for pico-storm
;;
;; Ported from ceu-sdl-storm (Céu + SDL) to pico-atmos.
;; Original by Psyny: https://github.com/psyny
;;

val DROPS_PERSEC_MIN =  10
val DROPS_PERSEC_MAX = 100
val DROPS_DECAY_MS   = 2000
val DROPS_LEN        = 2
val DROPS_LEN0       = 5                ;; initial height
val DROPS_LEN_MAX    = DROPS_LEN * 4

;; Broad phase of the collisions, on plain numbers:
;;   - NEAR: rects up to NEAR pixels apart are candidates
;;     (the rects are rounded to pixels, which moves an edge
;;     by less than 1 pixel)
;;   - GRID: side of the cells of the grid of drops, such
;;     that close drops are in the same or in adjacent cells
val NEAR = 2
val GRID = DROPS_LEN_MAX + NEAR

;; --------------------------------------------------------
;; Helpers
;; --------------------------------------------------------

;; A physics state holds, for each axis, the position of the
;; center (pst) and the length (len): the rect goes from
;; `pst - len/2` to `pst + len/2`.

;; Build a pico rect from physics state
func phy_rect (p) {
    return ([
        '!',
        x = p.x.pst,
        y = p.y.pst,
        w = p.x.len,
        h = p.y.len,
    ])
}

;; Broad phase: tells if the rects of two physics states are
;; close (up to NEAR pixels apart). Close rects are candidates
;; only: the collision itself remains with
;; `pico.vs.rect.rect`.
func phy_near (p1, p2) {
    val x1 = p1.x
    val x2 = p2.x
    val y1 = p1.y
    val y2 = p2.y
    val dx = x1.pst - x2.pst
    val dy = y1.pst - y2.pst
    val w  = ((x1.len + x2.len) / 2) + NEAR
    val h  = ((y1.len + y2.len) / 2) + NEAR
    return ((dx <= w) && (-dx <= w) && (dy <= h) && (-dy <= h))
}

;; Explosion velocity based on distance
func Boom_Vel (boom, other, G) {
    val radius    = 80
    val magnitude = 20

    val c1 = [ x=boom.x.pst,  y=boom.y.pst  ]
    val c2 = [ x=other.x.pst, y=other.y.pst ]

    val dist = math.sqrt(
        math.pow(c2.x - c1.x, 2) + math.pow(c2.y - c1.y, 2)
    )

    var pct = dist / radius
    if pct > 1 {
        return ([ x=0, y=0 ])
    } else {
        if pct < 0.1 {
            set pct = 0.1
        }
    }
    set pct = 1.0 - math.cos(pct * G.PI)

    val vel = [
        x = math.cos(pct) * magnitude,
        y = math.sin(pct) * magnitude * -1,
    ]
    if c2.x < c1.x {
        set vel.x = -(vel.x)
    }
    if c2.y < c1.y {
        set vel.y = -(vel.y)
    }

    return (vel)
}

;; --------------------------------------------------------
;; Physics
;; --------------------------------------------------------

;; Updates velocity/position each frame, renders as rect.
;; Receives a mutable state table:
;;   [ x=[pst,len,vel,acc,drag],
;;      y=[pst,len,vel,acc,drag], clr ]
task Physics (state) {
    par {
        loop us on :clock {
            val dt = us / 1000000
            set state.x.vel =
                (state.x.vel + (state.x.acc * dt))
                * (1 - (state.x.drag * dt))
            set state.y.vel =
                (state.y.vel + (state.y.acc * dt))
                * (1 - (state.y.drag * dt))
            set state.x.pst =
                state.x.pst + (state.x.vel * dt)
            set state.y.pst =
                state.y.pst + (state.y.vel * dt)
        }
    } with {
        loop on :draw {
            if state.clr != nil {
                pico.set.pencil [ color=state.clr ]
                pico.output.draw.rect [
                    '!',
                    x = state.x.pst,
                    y = state.y.pst,
                    w = state.x.len,
                    h = state.y.len,
                ]
            }
        }
    }
}

;; --------------------------------------------------------
;; Wheel
;; --------------------------------------------------------

;; 12 rotating dots around a point on the car (an offset
;; from its center).
task Wheel (car_phy, offset, G) {
    val radius = 15
    val esp = (2 * G.PI) / 12
    var pst = 0

    par {
        loop us on :clock {
            val dt = us / 1000000
            val s = if car_phy.x.vel >= 0 => 1 => -1
            val mod = math.sqrt(
                math.pow(car_phy.x.vel, 2)
                + math.pow(car_phy.y.vel, 2)
            )
            set pst = pst + (s * mod * dt / radius)
        }
    } with {
        loop on :draw {
            pico.set.pencil [
                color=[ r=0xFF, g=0x9D, b=0x46 ]
            ]
            var i = 0
            loop {
                if i >= 12 {
                    break
                }
                pico.output.draw.rect [
                    '!',
                    x = car_phy.x.pst + offset.x
                        + (radius * math.cos(
                            (i * esp) + pst)),
                    y = car_phy.y.pst + offset.y
                        + (radius * math.sin(
                            (i * esp) + pst)),
                    w = 5,
                    h = 5,
                ]
                set i = i + 1
            }
        }
    }
}

;; --------------------------------------------------------
;; Car
;; --------------------------------------------------------

;; Player-controlled car with 2 wheels.
;; Exposes physics via pub.phy.
task Car (G) {
    val phy = [
        x = [
            pst=350, len=60, vel=0, acc=0, drag=0.95
        ],
        y = [
            pst=445, len=30, vel=0, acc=0, drag=0.95
        ],
        clr = [ r=0x3B, g=0xBC, b=0x48 ],
    ]
    set pub = [ phy=phy ]

    spawn Physics(phy)
    ;; a wheel turns around each bottom corner of the car,
    ;; where the top-left corner of a dot of 5x5 would be
    val wx = (phy.x.len / 2) - 2.5
    val wy = (phy.y.len / 2) + 2.5
    spawn Wheel(phy, [ x=-(wx), y=wy ], G)
    spawn Wheel(phy, [ x=wx+5,  y=wy ], G)

    par {
        loop {
            await :key.dn [key='Left']
            set phy.x.acc = -400
            await :key.up [key='Left']
            set phy.x.acc = 0
        }
    } with {
        loop {
            await :key.dn [key='Right']
            set phy.x.acc = 400
            await :key.up [key='Right']
            set phy.x.acc = 0
        }
    }
}

;; --------------------------------------------------------
;; Drop
;; --------------------------------------------------------

;; A raindrop: falls with gravity, bounces off ground,
;; stretches based on velocity, decays after bounce.
task Drop (cloud_phy, G) {
    ;; below the cloud, from its left side
    val x0 = (cloud_phy.x.pst - (cloud_phy.x.len / 2))
              + math.random(0, cloud_phy.x.len - 1)
              + (DROPS_LEN / 2)
    val y0 = cloud_phy.y.pst + (cloud_phy.y.len / 2)
              + (DROPS_LEN0 / 2)

    val phy = [
        x = [
            pst  = x0,
            len  = DROPS_LEN,
            vel  = cloud_phy.x.vel,
            acc  = 0,
            drag = 0.98,
        ],
        y = [
            pst  = y0,
            len  = DROPS_LEN0,
            vel  = 0,
            acc  = 500,
            drag = 0.98,
        ],
        clr = [ r=0x98, g=0xC1, b=0xE4 ],
    ]
    set pub = [
        phy          = phy,
        has_collided = false,
    ]

    spawn Physics(phy)

    par :any {
        loop on :clock {
            ;; bounce off ground
            if phy.y.pst > (G.H - (DROPS_LEN / 2)) {
                set phy.y.pst = G.H - (DROPS_LEN / 2)
                set phy.y.vel = -(phy.y.vel * 2 / 3)
                set pub.has_collided = true
            }

            ;; out of bounds
            if (phy.x.pst > G.W) || (phy.x.pst < 0) || (phy.y.pst < 0) {
                break
            }

            ;; stretch based on velocity, around the centre
            val abs_vx = math.abs(phy.x.vel)
            val abs_vy = math.abs(phy.y.vel)
            if abs_vx > abs_vy {
                set phy.x.len =
                    DROPS_LEN * (1 + ((abs_vx - abs_vy)
                                      / 100))
                set phy.y.len = DROPS_LEN
            } else {
                set phy.x.len = DROPS_LEN
                set phy.y.len =
                    DROPS_LEN * (1 + ((abs_vy - abs_vx)
                                      / 100))
            }

            ;; clamp size
            val tmax = DROPS_LEN_MAX
            if phy.x.len > tmax {
                set phy.x.len = tmax
            }
            if phy.y.len > tmax {
                set phy.y.len = tmax
            }
        }
    } with {
        ;; decay: wait for ground hit, then fade out
        watching until pub.has_collided {
            await(false)
        }
        await (DROPS_DECAY_MS * 1ms)
    }
}

;; --------------------------------------------------------
;; Cloud
;; --------------------------------------------------------

;; A rain cloud: spawns drops, blinks on collision,
;; adjusts drop frequency over time.
task Cloud (dps_, G) {
    var dps = dps_

    val maxy = 2 * 1000 / DROPS_PERSEC_MIN

    val freq_ini = 1000 / dps
    var freq_cur = freq_ini
    var ty = maxy - (freq_cur * 2)
    if ty < 1 {
        set ty = 1
    }

    ;; `ty` is the top of the cloud, which starts with its
    ;; left side at `-w`
    val w  = 100 + math.random(0, 99)
    val xl = 100 + math.random(0, 99)
    val xv =  10 + math.random(0, 49)
    val yl =  20 + math.random(0, 49)
    val phy = [
        x = [
            pst  = -(w) + (xl / 2),
            len  = xl,
            vel  = xv,
            acc  = 0,
            drag = 0,
        ],
        y = [
            pst  = ty + (yl / 2),
            len  = yl,
            vel  = 0,
            acc  = 0,
            drag = 0,
        ],
        clr = do {
            val v = 200 - ((200 * ty) / maxy)
            [ r=v, g=(v * 0.95) // 1, b=v ]
        },
    ]
    set pub = [ phy=phy, dps=dps ]

    spawn Physics(phy)

    par {
        ;; wrap around screen
        loop on :clock {
            if (phy.x.pst - (phy.x.len / 2)) > G.W {
                set phy.x.pst = -(phy.x.len / 2)
            }
        }
    } with {
        ;; spawn drops at current frequency
        loop {
            await (freq_cur * 1ms)
            spawn @(G.drops) Drop(phy, G)
        }
    } with {
        ;; blink white on :go_blink
        loop {
            await :go_blink
            val old = [
                r = phy.clr.r,
                g = phy.clr.g,
                b = phy.clr.b,
            ]
            set phy.clr = [
                r=0xFF, g=0xFF, b=0xFF
            ]
            await 100ms
            set phy.clr = old
        }
    } with {
        ;; adjust frequency when dps changes
        loop on 50ms {
            val new_freq = 1000 / pub.dps
            if new_freq == freq_cur {
                ;; no change
            } else {
                if math.abs(new_freq - freq_cur) < 1 {
                    set freq_cur = new_freq
                } else {
                    if (new_freq - freq_cur) > 0 {
                        set freq_cur = freq_cur + 1
                    } else {
                        set freq_cur = freq_cur - 1
                    }
                }

                set ty = maxy - (freq_cur * 2)
                if ty < 1 {
                    set ty = 1
                }
                set phy.y.pst = ty + (phy.y.len / 2)
                set phy.clr = [
                    r = 200 - ((200 * ty) / maxy),
                    g = (phy.clr.r * 0.95) // 1,
                    b = phy.clr.r,
                ]
            }
        }
    }
}

;; --------------------------------------------------------
;; Clouds
;; --------------------------------------------------------

;; Spawns 3 clouds, periodically redistributes drop rates.
task Clouds (G) {
    var dps_cur = 0

    var i = 0
    loop {
        if i >= 3 {
            break
        }
        val dps = math.random(
            DROPS_PERSEC_MIN,
            DROPS_PERSEC_MAX - dps_cur
              + DROPS_PERSEC_MIN
        )
        set dps_cur = dps_cur + dps
        if dps_cur > DROPS_PERSEC_MAX {
            set dps_cur = DROPS_PERSEC_MAX
        }
        spawn @(G.clouds) Cloud(dps, G)
        set i = i + 1
    }

    ;; periodically redistribute drop rates
    loop {
        val secs = math.random(1, 10)
        await (secs * 1s)
        loop _,cloud in G.clouds {
            if math.random(0, 2) == 0 {
                ;; skip 1 in 3
            } else {
                set dps_cur = dps_cur - cloud.pub.dps
                if dps_cur < DROPS_PERSEC_MIN {
                    set dps_cur = DROPS_PERSEC_MIN
                }
                val dps = math.random(
                    DROPS_PERSEC_MIN,
                    DROPS_PERSEC_MAX - dps_cur
                      + DROPS_PERSEC_MIN
                )
                set dps_cur = dps_cur + dps
                if dps_cur > DROPS_PERSEC_MAX {
                    set dps_cur = DROPS_PERSEC_MAX
                }
                set cloud.pub.dps = dps
            }
        }
        print("Drops per second: "
              ++ dps_cur ++ "/" ++ DROPS_PERSEC_MAX)
    }
}

;; --------------------------------------------------------
;; Boom
;; --------------------------------------------------------

;; Ground explosion: invisible physics body, lasts 100ms.
task Boom (x, G) {
    val radius = 80
    val phy = [
        x = [
            pst  = x,
            len  = radius * 2,
            vel  = 0,
            acc  = 0,
            drag = 0,
        ],
        y = [
            pst  = (G.H + (radius * 0.2)) // 1,
            len  = radius * 2,
            vel  = 0,
            acc  = 0,
            drag = 0,
        ],
        clr = nil,
    ]
    set pub = [ phy=phy ]

    spawn Physics(phy)
    await 100ms
}

;; --------------------------------------------------------
;; Light
;; --------------------------------------------------------

;; Recursive lightning bolt segment.
;; Spawns next segments + forks, Boom on ground hit.
task Light (G, pos_ini, direction, magnitude, is_fork) {
    val dir = direction
    val mag = magnitude
    val fork = is_fork

    val chaos = 30
    val d = G.PI
            * (dir - chaos + math.random(0, chaos * 2))
            / 180.0
    val pos_end = [
        x = pos_ini.x + (math.cos(d) * mag),
        y = pos_ini.y - (math.sin(d) * mag),
    ]

    watching 150ms {
        par {
            if pos_end.y >= G.H {
                ;; hit ground: spawn explosion
                if !fork {
                    spawn @(G.booms) Boom(
                        (pos_ini.x + pos_end.x) / 2, G
                    )
                }
            } else {
                if mag > 5 {
                    await 20ms

                    ;; next segment
                    val m = if fork
                        => (mag * 0.75) // 1
                        => mag
                    spawn @(G.lights) Light(
                        G, pos_end, dir, m, fork
                    )

                    ;; possible fork
                    if math.random(0, G.H - 1)
                       > pos_ini.y {
                        spawn @(G.lights) Light(
                            G, pos_ini,
                            math.random(180, 359),
                            (mag * 0.5) // 1,
                            true
                        )
                    }
                }
            }
            await(false)
        } with {
            loop on :draw {
                pico.set.pencil [
                    color=[ r=0xEA, g=0xD7, b=0xFF ]
                ]
                pico.output.draw.line(
                    [ '!',
                       x=pos_ini.x, y=pos_ini.y ],
                    [ '!',
                       x=pos_end.x, y=pos_end.y ]
                )
            }
        }
    }
}

;; --------------------------------------------------------
;; Collisions
;; --------------------------------------------------------

;; Four parallel collision checkers:
;;   1. cloud vs cloud  -> blink + lightning
;;   2. car   vs boom   -> push car
;;   3. drop  vs drop/car
;;   4. drop  vs boom   -> push drop
;; A `:clock` awakes many times in a frame (at each piece
;; of time between the timers that expire in it), and the
;; last piece has `late == 0`. Checker 3, which is the heavy
;; one, runs only then (once per frame). Checkers 2 and 4
;; integrate the time, and run at each piece.
;; With 300+ drops, there are 100000+ pairs of drops, of
;; which only a few are close. Checker 3 puts the drops in a
;; grid, by the cell of their positions, and compares each
;; drop only with those in the 3x3 cells around it, first as
;; plain numbers (as in `phy_near`). A wrong cell (two cells
;; with the same key) only adds candidates.
task Collisions (G) {
    par {
        ;; cloud vs cloud
        loop {
            val secs = math.random(0, 2)
            await (secs * 1s)
            loop _,c1 in G.clouds {
                loop _,c2 in G.clouds {
                    if (c1 != c2)
                       && pico.vs.rect.rect(
                              phy_rect(c1.pub.phy),
                              phy_rect(c2.pub.phy)) {
                        emit @c1 :go_blink
                        emit @c2 :go_blink
                        ;; between the left of c1 and
                        ;; the right of c2, and between
                        ;; the two bottoms
                        val p1 = c1.pub.phy
                        val p2 = c2.pub.phy
                        val pos = [
                            x = ((p1.x.pst - (p1.x.len / 2))
                                 + (p2.x.pst + (p2.x.len / 2)))
                                / 2,
                            y = ((p1.y.pst + (p1.y.len / 2))
                                 + (p2.y.pst + (p2.y.len / 2)))
                                / 2,
                        ]
                        spawn @(G.lights) Light(
                            G, pos, 270, 50, false
                        )
                    }
                }
            }
        }
    } with {
        ;; car vs boom
        loop us on :clock {
            val dt = us / 1000
            val car = G.car.pub.phy
            loop _,boom in G.booms {
                if pico.vs.rect.rect(
                       phy_rect(boom.pub.phy),
                       phy_rect(car)) {
                    val vel = Boom_Vel(
                        boom.pub.phy, car, G
                    )
                    set car.x.vel =
                        car.x.vel + (vel.x * dt / 20)
                }
            }
        }
    } with {
        ;; drop vs drop / car
        loop _,late on :clock {
            if late == 0 {      ;; once per frame
                val car = G.car.pub.phy

                ;; the drops of the frame, by index, with
                ;; their rects as plain numbers (centers
                ;; and half lengths, with the slack), and
                ;; the grid with the indexes in each cell
                pin ds = []
                val xs = []
                val ys = []
                val ws = []
                val hs = []
                val grid = []
                loop _,d in G.drops {
                    val p = d.pub.phy
                    val i = #ds
                    set ds@i = d
                    set xs@i = p.x.pst
                    set ys@i = p.y.pst
                    set ws@i = (p.x.len + NEAR) / 2
                    set hs@i = (p.y.len + NEAR) / 2
                    val k = ((p.x.pst // GRID) * 4096)
                            + (p.y.pst // GRID)
                    val c = grid@k
                    if c == nil {
                        set grid@k = [i]
                    } else {
                        set c@+ = i
                    }
                }

                loop i,d1 in ds {
                    val p1 = d1.pub.phy
                    val x1 = xs@i
                    val y1 = ys@i
                    val w1 = ws@i
                    val h1 = hs@i

                    ;; drop vs drop (only those in the
                    ;; 3x3 cells around d1)
                    val cx = x1 // GRID
                    val cy = y1 // GRID
                    loop gx in (cx-1, cx+1) {
                        loop gy in (cy-1, cy+1) {
                            val c = grid@((gx * 4096) + gy)
                            if c != nil {
                                loop _,j in c {
                                    val dx = x1 - xs@j
                                    val dy = y1 - ys@j
                                    val w  = w1 + ws@j
                                    val h  = h1 + hs@j
                                    if (dx <= w) && (-dx <= w)
                                       && (dy <= h) && (-dy <= h)
                                       && (j != i) {
                                        val d2 = ds@j
                                        if pico.vs.rect.rect(
                                               phy_rect(p1),
                                               phy_rect(d2.pub.phy)) {
                                            if d1.pub.has_collided {
                                                set p1.x.vel = 50
                                            }
                                            if d2.pub.has_collided {
                                                set d2.pub.phy.x.vel = -50
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    ;; drop vs car
                    if phy_near(p1, car)
                       && pico.vs.rect.rect(
                              phy_rect(p1),
                              phy_rect(car)) {
                        ;; above the top of the car?
                        val top = car.y.pst - (car.y.len / 2)
                        if (p1.y.pst - (p1.y.len / 2)) < top {
                            set p1.y.pst =
                                top - (p1.y.len / 2)
                            set p1.y.vel = -(p1.y.vel / 3)
                            set p1.x.vel = car.x.vel / 2
                            set d1.pub.has_collided = true

                            ;; d1 moved: also in the new cell
                            set ys@i = p1.y.pst
                            val k = (cx * 4096)
                                    + (p1.y.pst // GRID)
                            val c = grid@k
                            if c == nil {
                                set grid@k = [i]
                            } else {
                                set c@+ = i
                            }
                        } else {
                            set p1.x.vel = car.x.vel * 2
                            set p1.y.vel =
                                -(math.abs(car.x.vel))
                        }
                    }
                }
            }
        }
    } with {
        ;; drop vs boom
        loop us on :clock {
            val dt = us / 1000
            loop _,boom in G.booms {
                loop _,d1 in G.drops {
                    if phy_near(d1.pub.phy, boom.pub.phy)
                       && pico.vs.rect.rect(
                           phy_rect(d1.pub.phy),
                           phy_rect(boom.pub.phy)) {
                        val vel = Boom_Vel(
                            boom.pub.phy,
                            d1.pub.phy, G
                        )
                        set d1.pub.phy.x.vel =
                            d1.pub.phy.x.vel
                            + (vel.x * dt)
                        set d1.pub.phy.y.vel =
                            d1.pub.phy.y.vel
                            + (vel.y * dt)
                    }
                }
            }
        }
    }
}
