    _PICO_ATMOS_IN0("color.mix")
    Pico_Color c1, c2;
    _PICO_ATMOS_TRY(_pico_atmos_color(_PICO_ATMOS_ARG(0),&c1) && _pico_atmos_color(_PICO_ATMOS_ARG(1),&c2));
    a_push(_pico_atmos_mk_color(pico_color_mix(c1, c2)));
    return A_OK;
}

// pico.color.alpha(clr, a)
