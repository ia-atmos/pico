include "../pico.atm"

val IMG = "../c/res/open.png"

pico.open()
pico.set.window [ title="Image - Size - Crop" ]
pico.set.effect [ color='white' ]

;; pico.get.image
do {
    val dim = pico.get.image(IMG)
    assert(dim@0=='!' && dim.w==48 && dim.h==48)
}
do {
    val dim = pico.get.image(['!', h=24], IMG)
    assert(dim.w==24 && dim.h==24)
}
do {
    val dim = pico.get.image(['!', w=48, h=nil], IMG)
    assert(dim.w==48 && dim.h==48)
}
do {
    val dim = pico.get.image(['!'], IMG)
    assert(dim.w==48 && dim.h==48)
}
do {
    val dim = pico.get.image('%', IMG)
    assert(dim@0=='%' && pico.equal(dim.w,0.48) && pico.equal(dim.h,0.48))
}

do {
    print("show top-left from center")
    val r = ['!', x=50, y=50, w=0, h=0, anchor='NW']
    pico.output.clear()
    pico.output.draw.image(IMG, r)
    assert(r.w==48 && r.h==48)
    pico.check("image_raw-01")
}

do {
    print("show small centered")
    val r = ['!', x=50-5, y=50-5, w=10, h=10, anchor='NW']
    pico.output.clear()
    pico.output.draw.image(IMG, r)
    pico.check("image_raw-02")
}

do {
    print("show small/medium distorted")
    val r = ['!', x=50-5, y=50-10, w=10, h=20, anchor='NW']
    pico.output.clear()
    pico.output.draw.image(IMG, r)
    pico.check("image_raw-03")
}

do {
    print("show medium normal")
    pico.output.clear()
    val r = ['!', x=50-10, y=50-10, w=20, h=0, anchor='NW']
    pico.output.draw.image(IMG, r)
    pico.check("image_raw-04")
}

do {
    print("show small normal")
    pico.output.clear()
    val r = ['!', x=50-5, y=50-5, w=0, h=10, anchor='NW']
    pico.output.draw.image(IMG, r)
    pico.check("image_raw-05")
}

do {
    print("show big centered")
    pico.output.clear()
    val r = ['!', x=50-24, y=50-24, w=0, h=0, anchor='NW']
    pico.output.draw.image(IMG, r)
    pico.check("image_raw-06")
}

;; CROP
do {
    print("show big croped")
    pico.output.clear()
    val crop = pico.layer.image [ path=IMG ]
    pico.set.layer(crop)
    pico.set.scene [
        source = ['!', x=9, y=9, w=30, h=30, anchor='NW']
    ]
    pico.set.layer(pico.layer.world())
    val r1 = ['!', x=50-24, y=50-24, w=0, h=0, anchor='NW']
    pico.output.draw.layer(crop, r1)
    pico.check("image_raw-07")

    print("show medium normal")
    pico.output.clear()
    val r2 = ['!', x=50-10, y=50-10, w=20, h=0, anchor='NW']
    pico.output.draw.image(IMG, r2)
    pico.check("image_raw-08")
}

;; errors
do {
    val ok, err = catch true { pico.output.draw.image("no-such.png", ['!',x=0,y=0]) }
    assert(!ok)
    print(err)
}

pico.close()
