pico.set.window [ title="Dim" ]

val r = ['%', x=0.5, y=0.5, w=0, h=0]
var N = 1

;; Lua: `for i = 0, 100, 25` (5 iterations)
loop k in 5 {
    val i = k * 25
    pico.output.clear()
    set r.w = i/100.0
    set r.h = i/100.0
    pico.output.draw.rect(r)
    val fmt = string.format("dim-%02d", N)
    set N = N + 1
    print(fmt)
    pico.check(fmt)
}

set r.w = 0.8
set r.h = 0.8
;; Lua: `for i = 0, 125, 25` (6 iterations)
loop k in 6 {
    val i = k * 25
    pico.output.clear()

    pico.set.pencil [ color='white' ]
    pico.output.draw.rect(r)

    val rr = pico.in.rect(r, ['%', x=0.5, y=0.5, w=i/100.0, h=i/100.0])
    pico.set.pencil [ color=pico.color.alpha('red', 150) ]
    pico.output.draw.rect(rr)

    val fmt = string.format("dim-%02d", N)
    set N = N + 1
    print(fmt)
    pico.check(fmt)
}

pico.close()
