#!/bin/sh

VERSION=v0.8

if [ "$1" = --version ]; then
    echo pico-atmos $VERSION
    exit 0
fi

if [ $# -eq 0 ] || [ "$1" = --help ]; then
    echo "Usage: pico-atmos [options] <file.atm> [args]"
    echo ""
    echo "Options:"
    echo "  --help       Show this help"
    echo "  --version    Show version"
    echo ""
    echo "Environment:"
    echo "  ATMOS        The Atmos compiler (default: atmos in PATH)"
    echo ""
    echo "The program does not include the binding: it is compiled after"
    echo "pico.atm, starts with pico open, and runs from its own directory."
    echo "Exports PICO_ROOT, the absolute root of pico, to the program."
    exit 0
fi

PICO=$(dirname "$(realpath "$0")")      # /x/y/pico
ATMOS=${ATMOS:-atmos}

if ! command -v "$ATMOS" >/dev/null 2>&1; then
    echo "pico-atmos : compiler not found : $ATMOS (set ATMOS)" >&2
    exit 1
fi
case "$ATMOS" in
    */*) ATMOS=$(realpath "$ATMOS") ;;  # the directory changes below
esac

if [ ! -f "$1" ]; then
    echo "pico-atmos : file not found : $1" >&2
    exit 1
fi

DIR=$(cd "$(dirname -- "$1")" && pwd)   # /a/b/c (absolute)
ATM=$(basename -- "$1")                 # d.atm
shift

case "$PICO/$DIR/$ATM" in
    *[\"\\]*)
        echo "pico-atmos : invalid path : $DIR/$ATM" >&2
        exit 1
        ;;
esac

make -C "$PICO/c" lib >/dev/null || exit 1

# the root of the repository, for `pico.check` (c/tst/out, c/tst/asr)
export PICO_ROOT="$PICO"

export ATMOS_CFLAGS="${ATMOS_CFLAGS:--O1} -I$PICO/c/src"
export ATMOS_LDFLAGS="-L$PICO/c/src -lpico-sdl \
    -lm -lSDL2 -lSDL2_ttf -lSDL2_image -lSDL2_mixer -lSDL2_gfx $ATMOS_LDFLAGS"

# ATMOS_ASAN=1: ignores the leaks of the libraries under SDL
if [ -n "$ATMOS_ASAN" ] && [ -z "$LSAN_OPTIONS" ]; then
    export LSAN_OPTIONS="suppressions=$PICO/tst/lsan.supp:print_suppressions=0"
fi

# The program does not include the binding itself. A wrapper includes
# the binding and then the program, both with absolute paths, such that
# the messages of the compiler and the traces of errors name the file of
# the program. A program that also includes `pico.atm` is not affected:
# a file is only included once.
TMP=$(mktemp -d "${TMPDIR:-/tmp}/pico-atmos-XXXXXX") || exit 1
trap 'rm -rf "$TMP"' EXIT
trap 'exit 130' INT HUP TERM
printf 'include "%s"\ninclude "%s"\n' "$PICO/pico.atm" "$DIR/$ATM" \
    > "$TMP/main.atm"

# the program runs from its own directory
cd "$DIR/" || exit 1
"$ATMOS" "$TMP/main.atm" "$@"
