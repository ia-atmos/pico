static AStatus _pico_atmos_l_font_load (AFunc* self, int argc, AVal* argv) {
    _PICO_ATMOS_IN("font.load")
    const char* path;
    _PICO_ATMOS_TRY(_pico_atmos_str(_PICO_ATMOS_ARG(0),0,&path) && _pico_atmos_file(path));
    a_push(_pico_atmos_res_new(pico_font_load(path), 1));
    return A_OK;
}

// pico.sound.load(path)
static AStatus _pico_atmos_l_sound_load (AFunc* self, int argc, AVal* argv) {
    _PICO_ATMOS_IN("sound.load")
    const char* path;
    _PICO_ATMOS_TRY(_pico_atmos_str(_PICO_ATMOS_ARG(0),0,&path) && _pico_atmos_file(path));
    a_push(_pico_atmos_res_new(pico_sound_load(path), 0));
    return A_OK;
}

///////////////////////////////////////////////////////////////////////////////
// INPUT
///////////////////////////////////////////////////////////////////////////////

// pico.input.delay(ms): the time passed
static AStatus _pico_atmos_l_input_delay (AFunc* self, int argc, AVal* argv) {
    _PICO_ATMOS_IN("input.delay")
    if (!a_isnum(_PICO_ATMOS_ARG(0))) {
        return _pico_atmos_bad(0, "number", _PICO_ATMOS_ARG(0));
    }
    a_push(a_int(pico_input_delay((int) a_dbl(argv[0]))));
    return A_OK;
}

// pico.input.event(): the event (or nil), the time passed
// pico.input.event(ms)
// pico.input.event(filter [, ms])
//  - filter: a string of _PICO_ATMOS_EVENTS, or nil for any event
//  - ms: an integer >= 0, or nil (or -1) to wait with no timeout
//  - further arguments are ignored
static AStatus _pico_atmos_l_input_event (AFunc* self, int argc, AVal* argv) {
    _PICO_ATMOS_IN("input.event")
    AVal a0 = _PICO_ATMOS_ARG(0);
    AVal a1 = _PICO_ATMOS_ARG(1);
    AVal vms = a1;
    int ims = 1;
    int64_t n;
    if (a1.type==A_NIL && a0.type!=A_STR && a0.type!=A_NIL) {
        // (ms)
        vms = a0;
        ims = 0;
        if (!a_toint(a0, &n)) {
            return _pico_atmos_bad(0, "string or integer", a0);
        }
    } else if (a0.type!=A_STR && a0.type!=A_NIL) {
        return _pico_atmos_bad(0, "string", a0);
    }
    int ms = -1;
    if (vms.type != A_NIL) {
        _PICO_ATMOS_TRY(_pico_atmos_int(vms, ims, &ms));
        if (ms < -1) {
            return a_error("%s : invalid timeout", _PICO_ATMOS_FN);
        }
    }
    int id = PICO_EVENT_ANY;
    if (a0.type == A_STR) {
        for (int i=0; i<_PICO_ATMOS_NEVENTS; i++) {
            if (!strcmp(_PICO_ATMOS_EVENTS[i].name, A_STR_OF(a0)->s)) {
                id = _PICO_ATMOS_EVENTS[i].id;
            }
        }
        if (id == PICO_EVENT_ANY) {
            return a_error("%s : invalid event \"%s\"",
                _PICO_ATMOS_FN, A_STR_OF(a0)->s);
        }
    }
    Pico_Event e;
    int dt = (ms == -1) ? pico_input_event(&e, id)
                        : pico_input_event_timeout(&e, id, ms);
    a_push((e.type == PICO_EVENT_NONE) ? a_nil() : _pico_atmos_mk_event(&e));
    a_push(a_int(dt));
    return A_OK;
}

// pico.input.loop()
static AStatus _pico_atmos_l_input_loop (AFunc* self, int argc, AVal* argv) {
    _PICO_ATMOS_IN("input.loop")
    pico_input_loop();
    return A_OK;
}

///////////////////////////////////////////////////////////////////////////////
// OUTPUT
///////////////////////////////////////////////////////////////////////////////

// pico.output.clear()
static AStatus _pico_atmos_l_output_clear (AFunc* self, int argc, AVal* argv) {
    _PICO_ATMOS_IN("output.clear")
    pico_output_clear();
    return A_OK;
}

// pico.output.draw.image(path, rect)
static AStatus _pico_atmos_l_output_draw_image (AFunc* self, int argc, AVal* argv) {
    _PICO_ATMOS_IN("output.draw.image")
    const char* path;
    Pico_Rel_Rect rect;
    _PICO_ATMOS_TRY(_pico_atmos_str(_PICO_ATMOS_ARG(0),0,&path) && _pico_atmos_file(path));
    _PICO_ATMOS_TRY(_pico_atmos_rect(_PICO_ATMOS_ARG(1), &rect));
    Pico_Rel_Dim dim = { rect.mode, {rect.w, rect.h} };
    pico_get_image(&dim, path);         // completes the rect of the caller
    _pico_atmos_set(argv[1], "w", a_num(dim.w));
    _pico_atmos_set(argv[1], "h", a_num(dim.h));
    rect.w = dim.w;
    rect.h = dim.h;
    pico_output_draw_image(path, rect);
    return A_OK;
}

// pico.output.draw.layer(layer [, rect])
static AStatus _pico_atmos_l_output_draw_layer (AFunc* self, int argc, AVal* argv) {
