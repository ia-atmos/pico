static AStatus _pico_atmos_color_pct (int argc, AVal* argv, Pico_Color (*f)(Pico_Color,float)) {
    Pico_Color clr;
    _PICO_ATMOS_TRY(_pico_atmos_color(_PICO_ATMOS_ARG(0), &clr));
    if (!a_isnum(_PICO_ATMOS_ARG(1))) {
        return _pico_atmos_bad(1, "number", _PICO_ATMOS_ARG(1));
    }
    a_push(_pico_atmos_mk_color(f(clr, a_dbl(_PICO_ATMOS_ARG(1)))));
    return A_OK;
}

// pico.color.darker(clr, pct)
static AStatus _pico_atmos_l_color_darker (AFunc* self, int argc, AVal* argv) {
