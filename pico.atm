    _PICO_ATMOS_TRY(_pico_atmos_color(_PICO_ATMOS_ARG(0),&clr) && _pico_atmos_int(_PICO_ATMOS_ARG(1),1,&a));
    a_push(_pico_atmos_mk_color(pico_color_alpha(clr, a)));
    return A_OK;
}

