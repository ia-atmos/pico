include "../pico.atm"

pico.open()
pico.set.window [ title="Expert" ]

val r = ['%', x=0.5, y=0.5, w=0.5, h=0.5]
pico.output.draw.rect(r)
pico.check("expert-01")

pico.set.expert(true)
pico.output.clear()
pico.check("expert-02")

pico.output.present()
pico.check("expert-03")

;; test: delay returns dt
val dt = pico.input.delay(100)
assert(dt>=100 && dt<=110)  ;; 110 b/c of valgrind

pico.close()
